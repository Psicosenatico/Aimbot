local candidates = {}
local seenCandidate = {}

local function add_candidate(tag, value)
    if type(value) ~= "string" or #value < 4 then return end
    local key = tag .. "\0" .. value
    if seenCandidate[key] then return end
    seenCandidate[key] = true
    candidates[#candidates + 1] = "[" .. tag .. "] " .. value
end

for _, item in ipairs(strings) do
    local vals = {item.raw, unescape_luaish(item.raw)}
    for _, v in ipairs(vals) do
        for url in v:gmatch("https?://[^%s\"'<>]+") do
            add_candidate("URL", url)
        end
        for host in v:gmatch("[%w%-_]+%.[%a][%a%d%-_%.]+") do
            if #host >= 6 then add_candidate("HOST/PATH", host) end
        end
        if #v >= 8 and printable_ratio(v) > 0.92 then
            local low = v:lower()
            if low:find("http", 1, true)
                or low:find("discord", 1, true)
                or low:find("github", 1, true)
                or low:find("remote", 1, true)
                or low:find("workspace", 1, true)
                or low:find("player", 1, true)
                or low:find("ball", 1, true)
                or low:find("aim", 1, true)
                or low:find("solution", 1, true)
                or low:find("reward", 1, true)
                or low:find("skin", 1, true)
                or low:find("level", 1, true)
            then
                add_candidate("KEYWORD", v)
            end
        end
    end
end

