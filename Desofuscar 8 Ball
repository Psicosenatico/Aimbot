                elseif tv == "function" then
                    inspect_fn(v, path .. ".up[" .. tostring(i) .. "]", depth + 1)
                end
            end
        end
    end

    if type(getprotos_fn) == "function" then
        local ok, protos = pcall(getprotos_fn, fn)
        if ok and type(protos) == "table" then
            constantsOutput[#constantsOutput + 1] =
                "protos_count=" .. tostring(#protos)
            for i, p in ipairs(protos) do
                if type(p) == "function" then
                    inspect_fn(p, path .. ".proto[" .. i .. "]", depth + 1)
                end
            end
        else
            constantsOutput[#constantsOutput + 1] =
                "getprotos indisponivel/falhou: " .. safe_tostring(protos)
        end
    else
        constantsOutput[#constantsOutput + 1] = "getprotos: API inexistente"
    end
end

