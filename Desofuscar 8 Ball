local function parse_quoted_strings(s)
    local out = {}
    local i, n = 1, #s
    while i <= n do
        local q = s:sub(i, i)
        if q == "'" or q == '"' then
            local start = i
            i = i + 1
            local buf = {}
            while i <= n do
                local c = s:sub(i, i)
                if c == "\\" then
                    if i < n then
                        buf[#buf + 1] = c
                        buf[#buf + 1] = s:sub(i + 1, i + 1)
                        i = i + 2
                    else
                        buf[#buf + 1] = c
                        i = i + 1
                    end
                elseif c == q then
                    out[#out + 1] = {
                        raw = table.concat(buf),
                        quote = q,
                        start_pos = start,
                        end_pos = i
                    }
                    i = i + 1
                    break
                else
                    buf[#buf + 1] = c
                    i = i + 1
                end
            end
        else
            i = i + 1
        end
    end
    return out
end

local function unescape_luaish(s)
    -- Tenta somente escapes comuns, decimal e hex.
    s = s:gsub("\\x(%x%x)", function(h)
        local v = tonumber(h, 16)
        return v and string.char(v) or "\\x" .. h
    end)

    s = s:gsub("\\(%d%d?%d?)", function(d)
        local v = tonumber(d, 10)
        if v and v >= 0 and v <= 255 then
            return string.char(v)
        end
        return "\\" .. d
    end)

    local map = {
        ["n"] = "\n", ["r"] = "\r", ["t"] = "\t",
        ["b"] = "\b", ["f"] = "\f", ["v"] = "\v",
        ["\\"] = "\\", ['"'] = '"', ["'"] = "'"
    }
    s = s:gsub("\\(.)", function(c)
        return map[c] or ("\\" .. c)
    end)
    return s
end

local function printable_ratio(s)
    if #s == 0 then return 1 end
    local good = 0
    for i = 1, #s do
        local b = string.byte(s, i)
        if b == 9 or b == 10 or b == 13 or (b >= 32 and b <= 126) then
            good = good + 1
        end
    end
    return good / #s
end

