local function rolling_hash(s)
    -- Hash simples e deterministico; nao e criptografico.
    local h = 2166136261
    for i = 1, #s do
        h = (h * 131 + string.byte(s, i)) % 4294967296
    end
    return string.format("%08X", h)
end

