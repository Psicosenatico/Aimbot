                "constants_count=" .. tostring(#consts)
            for i, v in ipairs(consts) do
                if not emit_const(path, i, v) then break end
            end
        else
            constantsOutput[#constantsOutput + 1] =
                "getconstants indisponivel/falhou: " .. safe_tostring(consts)
        end
    else
        constantsOutput[#constantsOutput + 1] = "getconstants: API inexistente"
    end

    if type(getupvalues_fn) == "function" then
        local ok, ups = pcall(getupvalues_fn, fn)
        if ok and type(ups) == "table" then
            constantsOutput[#constantsOutput + 1] =
                "upvalues_count=" .. tostring(#ups)
            for i, v in pairs(ups) do
                local tv = type(v)
                if tv == "string" or tv == "number" or tv == "boolean" then
                    constantsOutput[#constantsOutput + 1] =
                        string.format("%s upvalue[%s] %s :: %s",
