-- 5) "PRETTY" ESTAGIO ZERO: APENAS QUEBRA SEGURA FORA DE STRINGS
-- Nao e um decompilador; serve para tornar a camada externa inspecionavel.
local function stage0_pretty(s)
    local out = {}
    local quote = nil
    local escaped = false
    local i = 1
    while i <= #s do
        local c = s:sub(i, i)
        if quote then
            out[#out + 1] = c
            if escaped then
                escaped = false
            elseif c == "\\" then
                escaped = true
            elseif c == quote then
                quote = nil
            end
        else
            if c == "'" or c == '"' then
                quote = c
                out[#out + 1] = c
            elseif c == ";" then
                out[#out + 1] = ";\n"
            else
                out[#out + 1] = c
            end
        end
        i = i + 1
    end
    return table.concat(out)
end

