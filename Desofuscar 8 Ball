local constantsOutput = {}
local totalConstants = 0
local maxConstants = 50000
local maxDepth = 20
local seenFns = {}

local function emit_const(path, idx, v)
    totalConstants = totalConstants + 1
    if totalConstants > maxConstants then return false end

    local tv = type(v)
    if tv == "string" then
        constantsOutput[#constantsOutput + 1] =
            string.format("%s const[%s] string len=%d printable=%.3f :: %q",
                path, tostring(idx), #v, printable_ratio(v), v)
        if v:find("http", 1, true) or v:find("Http", 1, true) then
            add_candidate("CONST_HTTP", v)
        end
    elseif tv == "number" or tv == "boolean" or tv == "nil" then
        constantsOutput[#constantsOutput + 1] =
            string.format("%s const[%s] %s :: %s",
                path, tostring(idx), tv, safe_tostring(v))
    else
        constantsOutput[#constantsOutput + 1] =
            string.format("%s const[%s] %s :: %s",
                path, tostring(idx), tv, safe_tostring(v))
    end
    return true
end

