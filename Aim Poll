    Color3.fromRGB(80, 220, 255),  -- TrajDeflectLine
    Color3.fromRGB(255, 220, 60),  -- TrajHitLine
}

local BEAM_NAMES = {
    "AimMain",
    "AimDefl",
    "AimHit",
}

local SOURCE_NAMES = {
    "TrajMainLine",
    "TrajDeflectLine",
    "TrajHitLine",
}

local pool = {}
local state = {
    pool = pool,
    connection = nil,
    gui = nil,
    floatGui = nil,
    connections = {},
}

local function trackConnection(conn)
    if conn then
        table.insert(state.connections, conn)
    end
    return conn
end

ENV[STATE_KEY] = state

-- ============================================================
-- Utilidades seguras
-- ============================================================
local function clamp(n, minV, maxV)
    n = tonumber(n) or minV
    if n < minV then return minV end
    if n > maxV then return maxV end
    return n
end

local function safeParent(inst)
    if not inst then
        return nil, false
    end

    local ok, parent = pcall(function()
        return inst.Parent
    end)

    return parent, ok
end

local function isAlive(inst)
    local parent, ok = safeParent(inst)
    return ok and parent ~= nil
end

local function safeProperty(inst, property)
    if not inst then
        return nil, false
    end

    local ok, value = pcall(function()
        return inst[property]
    end)

    if not ok then
        return nil, false
    end

    return value, true
end

local function safeSetTransparency(inst, value)
    if not inst then return end
    pcall(function()
        inst.Transparency = value
    end)
end

-- ============================================================
-- Beam pool
-- ============================================================
local function createBeam(idx)
    local old = pool[idx]
    if old then
        pcall(function()
            old:Destroy()
        end)
    end

    local b = Instance.new("Part")
    b.Name = BEAM_NAMES[idx]
    b.Anchored = true
    b.CanCollide = false
    b.CanQuery = false
    b.CanTouch = false
    b.CastShadow = false
    b.Material = Enum.Material.Neon
    b.Color = COLORS[idx]
    b.Transparency = 1
    b.Shape = Enum.PartType.Cylinder
    b.Size = Vector3.new(1, cfg.thick, cfg.thick)
    b.Parent = Workspace

    pool[idx] = b
    return b
end

local function getBeam(idx)
    local b = pool[idx]

    -- CORREÇÃO PRINCIPAL:
    -- O original testava somente se pcall falhava.
    -- Parent == nil retorna pcall=true, parent=nil e passava despercebido.
    if not isAlive(b) then
        pool[idx] = nil
        b = createBeam(idx)
    end

    return b
end

local function hideOne(idx)
    safeSetTransparency(pool[idx], 1)
end

local function hideAll()
    for i = 1, 3 do
        hideOne(i)
    end
end

local function destroyAllBeams()
    for i = 1, 3 do
        local b = pool[i]
        pool[i] = nil
        if b then
            pcall(function()
                b:Destroy()
            end)
        end
    end
end

-- ============================================================
-- Overlay da linha estendida
-- ============================================================
local function overlay(idx, gameLine)
    if not gameLine then
        hideOne(idx)
        return
    end

    local transparency, okTransparency = safeProperty(gameLine, "Transparency")
    if not okTransparency or type(transparency) ~= "number" or transparency > 0.5 then
        hideOne(idx)
        return
    end

    -- CORREÇÃO:
    -- O original fazia pcall(Size.X) e depois acessava Size.X novamente
    -- fora da proteção.
    local size, okSize = safeProperty(gameLine, "Size")
    if not okSize or typeof(size) ~= "Vector3" then
        hideOne(idx)
        return
    end

    local L = size.X
    if type(L) ~= "number" or L < 0.1 then
        hideOne(idx)
        return
    end

    -- CORREÇÃO:
    -- CFrame também é lido uma única vez dentro do pcall.
    local cf, okCF = safeProperty(gameLine, "CFrame")
    if not okCF or typeof(cf) ~= "CFrame" then
        hideOne(idx)
        return
    end

    local dir = cf.RightVector
    local mid = cf.Position

    if dir.Magnitude < 0.001 then
        hideOne(idx)
        return
    end

    dir = dir.Unit

    -- Mantém o início da linha original.
    local startPos = mid - dir * L * 0.5

    local okBeam, b = pcall(getBeam, idx)
    if not okBeam or not b then
        return
    end

    local newLen = math.max(0.1, L * cfg.mult)
    local nMid = startPos + dir * (0.3 + newLen * 0.5)

    pcall(function()
        b.Color = COLORS[idx]
        b.Size = Vector3.new(newLen, cfg.thick, cfg.thick)

        -- Preserva a mesma estratégia geométrica do payload original.
        b.CFrame =
            CFrame.new(nMid, nMid + dir)
            * CFrame.Angles(0, math.pi * 0.5, 0)

        b.Transparency = cfg.transparency
    end)
end

-- ============================================================
-- Atualização
-- ============================================================
local ticker = 0

local function findTrajectoryViz()
    -- Mantém primeiro a localização utilizada pelo script original.
    return Workspace:FindFirstChild("TrajectoryViz")
end

local function update()
    if not cfg.on then
        hideAll()
        return
    end

    ticker += 1

    -- Verificação periódica corrigida.
    if ticker >= 120 then
        ticker = 0

        for i = 1, 3 do
            if pool[i] and not isAlive(pool[i]) then
                pool[i] = nil
            end
        end
    end

    local tv = findTrajectoryViz()
    if not tv then
        hideAll()
        return
    end

    for i = 1, 3 do
        overlay(i, tv:FindFirstChild(SOURCE_NAMES[i]))
    end
end

state.connection = RunService.RenderStepped:Connect(function()
    local ok, err = pcall(update)
    if not ok then
        -- Não interrompe o loop por um erro transitório do jogo.
        warn("[8BALL-X V15] Update error:", err)
        hideAll()
    end
end)

-- ============================================================
-- API para console / outros menus
-- ============================================================
local API = {}

function API.on()
    cfg.on = true
    return cfg.on
end

function API.off()
    cfg.on = false
    hideAll()
    return cfg.on
end

function API.toggle()
    cfg.on = not cfg.on
    if not cfg.on then
        hideAll()
    end
    return cfg.on
end

function API.x(n)
    cfg.mult = clamp(n or cfg.mult, 2, 15)
    return cfg.mult
end

function API.thickness(n)
    cfg.thick = clamp(n or cfg.thick, 0.04, 0.20)
    return cfg.thick
end

function API.status()
    local tv = Workspace:FindFirstChild("TrajectoryViz")

    return {
        on = cfg.on,
        mult = cfg.mult,
        thick = cfg.thick,
        trajectoryViz = tv ~= nil,
        main = tv and tv:FindFirstChild("TrajMainLine") ~= nil or false,
        deflect = tv and tv:FindFirstChild("TrajDeflectLine") ~= nil or false,
        hit = tv and tv:FindFirstChild("TrajHitLine") ~= nil or false,
    }
end

function API.destroy()
    cfg.on = false

    pcall(function()
        if state.connection then
            state.connection:Disconnect()
            state.connection = nil
        end
    end)

    for _, conn in ipairs(state.connections) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    table.clear(state.connections)

    destroyAllBeams()

    pcall(function()
        if state.gui then
            state.gui:Destroy()
            state.gui = nil
        end
    end)

    pcall(function()
        if state.floatGui then
            state.floatGui:Destroy()
            state.floatGui = nil
        end
    end)

    ENV[STATE_KEY] = nil
end

ENV.Extend = API

