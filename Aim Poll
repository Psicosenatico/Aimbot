    pcall(function()
        if oldState.connection then
            oldState.connection:Disconnect()
        end
    end)

    pcall(function()
        if oldState.gui then
            oldState.gui:Destroy()
        end
    end)

    pcall(function()
        if oldState.floatGui then
            oldState.floatGui:Destroy()
        end
    end)

    if type(oldState.pool) == "table" then
        for _, part in pairs(oldState.pool) do
            pcall(function()
                if part then
                    part:Destroy()
                end
            end)
        end
    end
end

-- Remove sobras pelo nome, caso a execução anterior tenha sido interrompida.
for _, name in ipairs({ "AimMain", "AimDefl", "AimHit" }) do
    local old = Workspace:FindFirstChild(name)
    if old then
        pcall(function()
            old:Destroy()
        end)
