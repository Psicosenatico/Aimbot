Main.BackgroundColor3=Color3.fromRGB(17,22,31); Main.BorderSizePixel=0; Main.Size=UDim2.fromOffset(390,300); Main.Position=UDim2.new(.5,-195,.5,-150); Main.Parent=Gui; corner(Main,12)
