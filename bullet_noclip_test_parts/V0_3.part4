local GP=(function()
 if typeof(gethui)=="function" then local ok,p=pcall(gethui); if ok and p then return p end end
 return CoreGui
end)()
for _,x in ipairs(GP:GetChildren()) do
 if x.Name==C.GUI or x.Name=="PsicosenaticoBulletNoclipTest_V0_1" or x.Name=="PsicosenaticoBulletNoclipTest_V0_2" then pcall(function() x:Destroy() end) end
end
local Gui=Instance.new("ScreenGui")
Gui.Name=C.GUI
Gui.ResetOnSpawn=false
Gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
Gui.Parent=GP
local function corner(o,r) local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,r); c.Parent=o end
local function label(p,t,sz,pos,ts)
 local x=Instance.new("TextLabel")
 x.BackgroundTransparency=1; x.Text=t; x.TextColor3=Color3.fromRGB(235,239,245); x.Font=Enum.Font.Gotham; x.TextSize=ts or 13; x.TextXAlignment=Enum.TextXAlignment.Left; x.Size=sz; x.Position=pos; x.Parent=p
 return x
end
local function btn(p,t,sz,pos)
 local b=Instance.new("TextButton")
 b.BackgroundColor3=Color3.fromRGB(37,46,62); b.TextColor3=Color3.fromRGB(245,247,250); b.Font=Enum.Font.GothamSemibold; b.TextSize=14; b.Text=t; b.Size=sz; b.Position=pos; b.Parent=p; corner(b,8)
 return b
end
