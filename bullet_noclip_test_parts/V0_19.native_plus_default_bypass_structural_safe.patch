  local group=S.v019SelectedPassGroup or "nenhum"
  Reader.Text=string.format("Leitor V0.19\ncanPierce nativo: %s • Default bypass: %s\nGrupo seguro: %s • estáticas: %d\nAplicações: %d • falhas: %d • reversões: %d\nHumanoid bursts: %d • possíveis stops em 5: %d\nCanCollide/CanQuery: PRESERVADOS • Tycoon: PROTEGIDO",S.v018HookInstalled and "OK" or "FALHA",S.v019BypassEnabled and "ON" or "OFF",tostring(group),S.v019EligibleNow,S.v019GroupApplied,S.v019GroupApplyFailed,S.v019GroupReverts,S.v019NativeBurstHumanoidShots,S.v019NativeBurstFiveCapStops)
 end

 cleanup=function()
  S.v019BypassEnabled=false
  restoreAllV019("CLEANUP")
  cleanupV018()
 end
