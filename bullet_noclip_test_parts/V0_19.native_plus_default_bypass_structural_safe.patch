 if type(rt)=="table" then rt.cleanup=cleanup;rt.version=C.VERSION end

 event("V019_NATIVE_PLUS_DEFAULT_BYPASS_READY",{version=C.VERSION,nativeCanPierce=true,defaultRayBypass=true,tycoonProtected=true,humanoidTargetsExcluded=true,staticBasePartsOnly=true,physicalCharacterCollisionPreserved=true,writesCanCollide=false,writesCanQuery=false,writesCollisionGroup=true,writesTags=false})
