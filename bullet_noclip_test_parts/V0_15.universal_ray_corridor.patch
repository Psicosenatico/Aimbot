-- V0.15 UNIVERSAL RAY CORRIDOR
-- Builds on V0.14 ALL_NON_TYCOON.
-- V0.14 proved that Default-group rays ignore all non-Tycoon geometry, but the diagnostic
-- Player-group ray can still collide with PlayerOnly. V0.15 adds a narrow, temporary
-- query/collision suppression corridor only along the current aim ray, so the local shot
-- path can be tested independently of which Raycast CollisionGroup the weapon uses.
-- Workspace.Tycoons and Humanoid models are never suppressed.

C.VERSION="V0.15"
S.v015CorridorScans=0
S.v015Suppressions=0
S.v015Restores=0
S.v015SuppressionFailures=0
S.v015RestoreFailures=0
S.v015PeakSuppressed=0
S.v015PlayerRayReachedCharacter=0
S.v015PlayerRayBlockedTycoon=0
S.v015PlayerRayBlockedOther=0
S.v015PlayerRayNoHit=0
S.v015UnsupportedTerrain=0
S.v015Suppressed={}
S.v015LastCorridorState=nil
S.v015Frame=0

ENV.__PSICO_V015_RESULT={pcall(function()
 local function humanoidAncestorV015(o)
  local cur=o
  for _=1,14 do
   if not cur or cur==Workspace then break end
   if cur:IsA("Model") and cur:FindFirstChildOfClass("Humanoid") then return cur end
   cur=cur.Parent
  end
  return nil
 end

 local function isTycoonV015(o)
  local t=tycoons()
  return t~=nil and o~=t and o:IsDescendantOf(t)
 end

 local function isInternalV015(o)
  local n=string.lower(tostring(o and o.Name or ""))
  return string.find(n,"__psico_",1,true)~=nil
 end

 local function corridorPolicyV015(o)
  if not o then return "SEM_INSTANCIA" end
  if o==Workspace.Terrain or o:IsA("Terrain") then return "TERRAIN_VOXEL_NAO_SUPORTADO" end
  if not o:IsA("BasePart") then return "NAO_BASEPART" end
  if isTycoonV015(o) then return "TYCOON_PROTEGIDO" end
  if humanoidAncestorV015(o) then return "ALVO_HUMANOIDE" end
  if isInternalV015(o) then return "INTERNO_PSICO" end
  return "ATRAVESSAR"
 end

 local function playerRayGroupV015()
  for g,_ in pairs(S.groupStrategyCharacterGroups or {}) do
   if type(g)=="string" and g~="" then return g end
  end
  return "Player"
 end

 local function equippedRangeV015()
  local ch=LP.Character
  if ch then
   for _,x in ipairs(ch:GetChildren()) do
    if x:IsA("Tool") then
     local r=x:GetAttribute("range")
     if type(r)=="number" and r>0 then return r,x end
    end
   end
  end
  return 1200,nil
 end

 local function rayObbIntervalV015(origin,unitDir,maxDist,p)
  if not p or not p.Parent then return nil end
  local ok,cf,size=pcall(function() return p.CFrame,p.Size end)
  if not ok or not cf or not size then return nil end
  local lo=cf:PointToObjectSpace(origin)
  local ld=cf:VectorToObjectSpace(unitDir)
  local half=size*0.5
  local tmin=-math.huge
  local tmax=math.huge
  local function axis(o,d,h)
   if math.abs(d)<1e-7 then
    if o<-h or o>h then return false end
    return true
   end
   local a=(-h-o)/d
   local b=(h-o)/d
   if a>b then a,b=b,a end
   if a>tmin then tmin=a end
   if b<tmax then tmax=b end
   return tmin<=tmax
  end
  if not axis(lo.X,ld.X,half.X) then return nil end
  if not axis(lo.Y,ld.Y,half.Y) then return nil end
  if not axis(lo.Z,ld.Z,half.Z) then return nil end
  if tmax<0 then return nil end
  local entry=math.max(tmin,0)
  if entry>maxDist then return nil end
  return entry,math.min(tmax,maxDist)
 end

 local function suppressV015(p)
  if not p or not p.Parent or corridorPolicyV015(p)~="ATRAVESSAR" then return false end
  local meta=S.v015Suppressed[p]
  if meta then
   meta.lastSeen=os.clock()
   return true
  end
  local st=readPartState(p)
  local okC,eC=pcall(function() p.CanCollide=false end)
  local okQ,eQ=pcall(function() p.CanQuery=false end)
  local after=readPartState(p)
  local good=okC and okQ and after.canCollide==false and after.canQueryReadOk and after.canQuery==false
  if not good then
   S.v015SuppressionFailures+=1
   if S.v015SuppressionFailures<=30 then
    event("V015_SUPPRESS_FAILED",{path=full(p),before=st,after=after,canCollideError=tostring(eC),canQueryError=tostring(eQ)})
   end
   pcall(function() p.CanCollide=st.canCollide end)
   if st.canQueryReadOk then pcall(function() p.CanQuery=st.canQuery end) end
   return false
  end
  S.v015Suppressed[p]={
   path=full(p),
   debugId=st.debugId,
   originalCanCollide=st.canCollide,
   originalCanQuery=st.canQuery,
   canQueryReadOk=st.canQueryReadOk,
   lastSeen=os.clock()
  }
  S.v015Suppressions+=1
  local now=0
  for q,_ in pairs(S.v015Suppressed) do if q and q.Parent then now+=1 end end
  if now>S.v015PeakSuppressed then S.v015PeakSuppressed=now end
  return true
 end

 local function restoreOneV015(p,meta,reason)
  if not meta then return false end
  if not p or not p.Parent then
   if p then S.v015Suppressed[p]=nil end
   return true
  end
  local okC,eC=pcall(function() p.CanCollide=meta.originalCanCollide end)
  local okQ,eQ=true,nil
  if meta.canQueryReadOk then okQ,eQ=pcall(function() p.CanQuery=meta.originalCanQuery end) end
  local after=readPartState(p)
  local good=okC and (not meta.canQueryReadOk or okQ) and after.canCollide==meta.originalCanCollide and
   (not meta.canQueryReadOk or (after.canQueryReadOk and after.canQuery==meta.originalCanQuery))
  if good then
   S.v015Restores+=1
  else
   S.v015RestoreFailures+=1
   if S.v015RestoreFailures<=30 then
    event("V015_RESTORE_FAILED",{path=meta.path,reason=reason,after=after,canCollideError=tostring(eC),canQueryError=tostring(eQ)})
   end
  end
  S.v015Suppressed[p]=nil
  return good
 end

 local function restoreAllV015(reason)
  local list={}
  for p,m in pairs(S.v015Suppressed) do list[#list+1]={p=p,m=m} end
  for _,x in ipairs(list) do restoreOneV015(x.p,x.m,reason) end
 end

 local function currentSuppressedCountV015()
  local n=0
  for p,_ in pairs(S.v015Suppressed) do if p and p.Parent then n+=1 end end
  return n
 end

 local function refreshExistingSuppressedV015(origin,unitDir,maxDist)
  local now=os.clock()
  local list={}
  for p,m in pairs(S.v015Suppressed) do
   if not p or not p.Parent then
    list[#list+1]={p=p,m=m,reason="REMOVIDO"}
   elseif corridorPolicyV015(p)~="ATRAVESSAR" then
    list[#list+1]={p=p,m=m,reason="POLICY_CHANGED"}
   else
    local a,b=rayObbIntervalV015(origin,unitDir,maxDist,p)
    if a and b then
     m.lastSeen=now
    elseif now-(m.lastSeen or 0)>0.12 then
     list[#list+1]={p=p,m=m,reason="FORA_CORREDOR"}
    end
   end
  end
  for _,x in ipairs(list) do restoreOneV015(x.p,x.m,x.reason) end
 end

 local function scanCorridorV015(rangeOverride)
  local cam=Workspace.CurrentCamera
  if not cam then return {state="SEM_CAMERA"} end
  local range=rangeOverride
  if type(range)~="number" or range<=0 then range=select(1,equippedRangeV015()) end
  local origin=cam.CFrame.Position
  local unit=cam.CFrame.LookVector
  if unit.Magnitude<=0 then return {state="DIRECAO_INVALIDA"} end
  unit=unit.Unit

  refreshExistingSuppressedV015(origin,unit,range)

  local group=playerRayGroupV015()
  local rp=RaycastParams.new()
  rp.FilterType=Enum.RaycastFilterType.Exclude
  rp.IgnoreWater=true
  rp.CollisionGroup=group
  rp.FilterDescendantsInstances=LP.Character and {LP.Character} or {}

  local cursor=origin
  local travelled=0
  local suppressedThisScan=0
  local terminal=nil
  for _=1,48 do
   local remain=range-travelled
   if remain<=0.05 then terminal={state="SEM_HIT",distance=travelled} break end
   local hit=nil
   local ok,e=pcall(function() hit=Workspace:Raycast(cursor,unit*remain,rp) end)
   if not ok then terminal={state="ERRO_RAYCAST",error=tostring(e),distance=travelled}; break end
   if not hit then terminal={state="SEM_HIT",distance=range}; break end
   local seg=(hit.Position-cursor).Magnitude
   travelled+=seg
   local inst=hit.Instance
   local policy=corridorPolicyV015(inst)
   if policy=="ALVO_HUMANOIDE" then
    local hum=humanoidAncestorV015(inst)
    terminal={state="ALVO_HUMANOIDE",path=hum and full(hum) or full(inst),hitPath=full(inst),distance=travelled,group=group}
    break
   elseif policy=="TYCOON_PROTEGIDO" then
    terminal={state="TYCOON_PROTEGIDO",path=full(inst),distance=travelled,group=group}
    break
   elseif policy=="TERRAIN_VOXEL_NAO_SUPORTADO" then
    S.v015UnsupportedTerrain+=1
    terminal={state=policy,path=full(inst),distance=travelled,group=group}
    break
   elseif policy=="ATRAVESSAR" then
    if suppressV015(inst) then
     suppressedThisScan+=1
     cursor=hit.Position+unit*0.06
     travelled+=0.06
    else
     terminal={state="FALHA_SUPRESSAO",path=full(inst),distance=travelled,group=group}
     break
    end
   else
    terminal={state="BLOQUEIO_NAO_SUPRIMIDO",policy=policy,path=full(inst),distance=travelled,group=group}
    break
   end
  end
  if not terminal then terminal={state="LIMITE_48_CAMADAS",distance=travelled,group=group} end
  terminal.suppressedThisScan=suppressedThisScan
  terminal.suppressedNow=currentSuppressedCountV015()
  terminal.range=range
  terminal.time=os.clock()
  S.v015CorridorScans+=1
  S.v015LastCorridorState=terminal
  return terminal
 end

 local function verifyPlayerRayV015(tool)
  local cam=Workspace.CurrentCamera
  if not cam then return {state="SEM_CAMERA"} end
  local range=tool and tool:GetAttribute("range") or nil
  if type(range)~="number" or range<=0 then range=1200 end
  scanCorridorV015(range)

  local group=playerRayGroupV015()
  local rp=RaycastParams.new()
  rp.FilterType=Enum.RaycastFilterType.Exclude
  rp.IgnoreWater=true
  rp.CollisionGroup=group
  rp.FilterDescendantsInstances=LP.Character and {LP.Character} or {}
  local hit=nil
  local ok,e=pcall(function() hit=Workspace:Raycast(cam.CFrame.Position,cam.CFrame.LookVector*range,rp) end)
  if not ok then return {state="ERRO_RAYCAST",error=tostring(e),group=group} end
  if not hit then
   S.v015PlayerRayNoHit+=1
   return {state="SEM_HIT",group=group,range=range}
  end
  local policy=corridorPolicyV015(hit.Instance)
  local h=humanoidAncestorV015(hit.Instance)
  if h then
   S.v015PlayerRayReachedCharacter+=1
   return {state="ALVO_HUMANOIDE",group=group,path=full(h),hitPath=full(hit.Instance),distance=(hit.Position-cam.CFrame.Position).Magnitude}
  end
  if policy=="TYCOON_PROTEGIDO" then
   S.v015PlayerRayBlockedTycoon+=1
   return {state="TYCOON_PROTEGIDO",group=group,path=full(hit.Instance),distance=(hit.Position-cam.CFrame.Position).Magnitude}
  end
  S.v015PlayerRayBlockedOther+=1
  return {state="BLOQUEADO_OUTRO",policy=policy,group=group,path=full(hit.Instance),distance=(hit.Position-cam.CFrame.Position).Magnitude}
 end

 local oldShotReadV014=shotRead
 shotRead=function(tool,delta)
  oldShotReadV014(tool,delta)
  local rec=S.shots[#S.shots]
  if not rec then return end
  local d=verifyPlayerRayV015(tool)
  rec.v015UniversalPlayerRay=d
  rec.v015SuppressedNow=currentSuppressedCountV015()
  rec.v015CorridorState=S.v015LastCorridorState
  local entry=busV010 and busV010.last
  if entry and tonumber(entry.shotIndex)==tonumber(rec.index) then
   entry.v015UniversalPlayerRayState=d and d.state or nil
   entry.v015ClientReachedCharacter=d and d.state=="ALVO_HUMANOIDE" or false
   entry.v015BlockedByTycoon=d and d.state=="TYCOON_PROTEGIDO" or false
   entry.v015SuppressedNow=rec.v015SuppressedNow
  end
  event("V015_SHOT_PATH",{shotIndex=rec.index,state=d and d.state or nil,path=d and d.path or nil,group=d and d.group or nil,suppressedNow=rec.v015SuppressedNow})
  updateUI()
 end

 S.conns[#S.conns+1]=RunService.RenderStepped:Connect(function()
  if S.closed or not S.enabled then return end
  S.v015Frame+=1
  if S.v015Frame%2~=0 then return end
  local ok,e=pcall(scanCorridorV015)
  if not ok then
   S.v015SuppressionFailures+=1
   if S.v015SuppressionFailures<=30 then event("V015_CORRIDOR_ERROR",{error=tostring(e)}) end
  end
 end)

 local oldSetEnabledV014=setEnabled
 setEnabled=function(v,reason)
  if not v then restoreAllV015("NOCLIP_OFF") end
  oldSetEnabledV014(v,reason)
  if v and S.enabled then pcall(scanCorridorV015) end
 end

 S.conns[#S.conns+1]=Gui.Destroying:Connect(function()
  restoreAllV015("GUI_DESTROYING")
 end)

 local oldCleanupV014=cleanup
 cleanup=function()
  restoreAllV015("CLEANUP")
  oldCleanupV014()
 end
 local rt=ENV[C.KEY]
 if type(rt)=="table" then
  rt.cleanup=cleanup
  rt.version=C.VERSION
 end

 local oldPayloadV014=payload
 payload=function()
  local t=oldPayloadV014()
  t.version=C.VERSION
  t.policy=t.policy or {}
  t.policy.mode="ALL_NON_TYCOON_PLUS_UNIVERSAL_RAY_CORRIDOR_V015"
  t.policy.universalRayCorridor="Enquanto ativo, apenas BaseParts fora de Workspace.Tycoons e fora de Models com Humanoid que intersectam o corredor atual de mira recebem temporariamente CanCollide=false + CanQuery=false; isso torna o teste local independente do CollisionGroup do ray. As propriedades são restauradas ao sair do corredor, desativar ou fechar."
  t.policy.tycoonRuleV015="Workspace.Tycoons nunca entra na supressão temporária."
  t.policy.humanoidRuleV015="Partes de personagens/bots nunca entram na supressão temporária."
  t.policy.serverLimitV015="Mudanças permanecem client-side; sucesso do ray local não prova aceitação de dano pelo servidor."
  t.summary=t.summary or {}
  t.summary.v015CorridorScans=S.v015CorridorScans
  t.summary.v015Suppressions=S.v015Suppressions
  t.summary.v015Restores=S.v015Restores
  t.summary.v015SuppressionFailures=S.v015SuppressionFailures
  t.summary.v015RestoreFailures=S.v015RestoreFailures
  t.summary.v015PeakSuppressed=S.v015PeakSuppressed
  t.summary.v015SuppressedNow=currentSuppressedCountV015()
  t.summary.v015PlayerRayReachedCharacter=S.v015PlayerRayReachedCharacter
  t.summary.v015PlayerRayBlockedTycoon=S.v015PlayerRayBlockedTycoon
  t.summary.v015PlayerRayBlockedOther=S.v015PlayerRayBlockedOther
  t.summary.v015PlayerRayNoHit=S.v015PlayerRayNoHit
  t.summary.v015UnsupportedTerrain=S.v015UnsupportedTerrain
  t.summary.v015LastCorridorState=S.v015LastCorridorState
  return t
 end

 save=function()
  local ok,json=pcall(function() return HttpService:JSONEncode(payload()) end)
  if not ok then err("JSONEncode",json); return false,"Falha ao gerar JSON" end
  local name=string.format("Psicosenatico_BulletNoclip_Test_V0_15_%s_%s.json",tostring(game.PlaceId),tostring(os.time()))
  if typeof(writefile)=="function" then
   local a,b=pcall(writefile,name,json)
   if a then event("EXPORT",{method="writefile",file=name,bytes=#json}); return true,"Arquivo exportado: "..name else err("writefile",b) end
  end
  if typeof(setclipboard)=="function" then
   local a,b=pcall(setclipboard,json)
   if a then event("EXPORT",{method="clipboard",bytes=#json}); return true,"JSON copiado" else err("clipboard",b) end
  end
  return false,"Não foi possível salvar/copiar o JSON"
 end

 local oldUpdateUIV014=updateUI
 updateUI=function()
  oldUpdateUIV014()
  ver.Text=C.VERSION
  local c=currentSuppressedCountV015()
  local st=S.v015LastCorridorState and S.v015LastCorridorState.state or "AGUARDANDO"
  Reader.Text=Reader.Text..string.format("\nV0.15 corredor universal: %s\nSupressas agora: %d • pico: %d\nPlayer-ray → alvo: %d • Tycoon: %d • outro: %d\nFalhas sup/rest: %d/%d",
   tostring(st),c,S.v015PeakSuppressed,S.v015PlayerRayReachedCharacter,S.v015PlayerRayBlockedTycoon,S.v015PlayerRayBlockedOther,S.v015SuppressionFailures,S.v015RestoreFailures)
  State.Text=S.enabled and "Estado: ATIVO • TUDO FORA DO TYCOON • RAY UNIVERSAL" or "Estado: DESATIVADO • restaurado"
 end
end)}
if ENV.__PSICO_V015_RESULT[1]~=true then error("PSICOSENATICO V0.15 structural init: "..tostring(ENV.__PSICO_V015_RESULT[2])) end
event("V015_UNIVERSAL_RAY_CORRIDOR_READY",{allNonTycoon=true,tycoonProtected=true,humanoidTargetsExcluded=true,playerGroupRayCovered=true,temporaryQueryCollisionSuppression=true,preservesV014=true,version=C.VERSION})
pcall(updateUI)
