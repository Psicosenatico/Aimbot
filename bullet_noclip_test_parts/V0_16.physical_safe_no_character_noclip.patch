-- V0.16 PHYSICAL-SAFE / NO CHARACTER NOCLIP
-- Builds directly on V0.14. V0.15 is intentionally NOT loaded by the V0.16 loader.
-- Functional rule remains ALL_NON_TYCOON via the proven existing CollisionGroup strategy,
-- but this patch never writes CanCollide/CanQuery and verifies that apply/restore preserve them.

C.VERSION="V0.16"
S.v016PhysicalSafetyViolations=0
S.v016ApplyChecks=0
S.v016RestoreChecks=0
S.v016RayDiagnostics={DEFAULT={shots=0,character=0,tycoon=0,other=0,noHit=0,errors=0},PLAYER={shots=0,character=0,tycoon=0,other=0,noHit=0,errors=0}}
S.v016LastRayDiagnostics=nil

ENV.__PSICO_V016_RESULT={pcall(function()
 local function humAncestorV016(o)
  local cur=o
  for _=1,14 do
   if not cur or cur==Workspace then break end
   if cur:IsA("Model") and cur:FindFirstChildOfClass("Humanoid") then return cur end
   cur=cur.Parent
  end
  return nil
 end

 local function tycoonPartV016(o)
  local t=tycoons()
  return t~=nil and o and o~=t and o:IsDescendantOf(t)
 end

 local function sameBoolV016(a,b)
  return a==b
 end

 -- Final functional apply remains V0.14 collision-group only, with an explicit physical guard.
 local applyV014=apply
 apply=function(p,meta)
  if not p or not p.Parent then return false end
  local before=readPartState(p)
  local ok=applyV014(p,meta)
  local after=readPartState(p)
  S.v016ApplyChecks+=1
  local safe=sameBoolV016(before.canCollide,after.canCollide) and
   ((not before.canQueryReadOk) or (after.canQueryReadOk and sameBoolV016(before.canQuery,after.canQuery)))
  if not safe then
   S.v016PhysicalSafetyViolations+=1
   event("V016_PHYSICAL_SAFETY_VIOLATION_APPLY",{path=full(p),before=before,after=after})
   pcall(function() p.CanCollide=before.canCollide end)
   if before.canQueryReadOk then pcall(function() p.CanQuery=before.canQuery end) end
   meta.applied=false
   meta.groupApplied=false
   return false
  end
  return ok
 end

 local restoreV014=restore
 restore=function(p,meta)
  if not p or not p.Parent then return false end
  local before=readPartState(p)
  local ok=restoreV014(p,meta)
  local after=readPartState(p)
  S.v016RestoreChecks+=1
  local expectedCollide=meta and meta.baselineState and meta.baselineState.canCollide
  local expectedQueryReadable=meta and meta.baselineState and meta.baselineState.canQueryReadOk
  local expectedQuery=meta and meta.baselineState and meta.baselineState.canQuery
  local safe=(expectedCollide==nil or after.canCollide==expectedCollide) and
   ((not expectedQueryReadable) or (after.canQueryReadOk and after.canQuery==expectedQuery))
  if not safe then
   S.v016PhysicalSafetyViolations+=1
   event("V016_PHYSICAL_SAFETY_VIOLATION_RESTORE",{path=full(p),before=before,after=after,expectedCanCollide=expectedCollide,expectedCanQuery=expectedQuery})
   if expectedCollide~=nil then pcall(function() p.CanCollide=expectedCollide end) end
   if expectedQueryReadable then pcall(function() p.CanQuery=expectedQuery end) end
  end
  return ok and safe
 end

 local function firstCharacterGroupV016()
  for g,_ in pairs(S.groupStrategyCharacterGroups or {}) do
   if type(g)=="string" and g~="" then return g end
  end
  return "Player"
 end

 local function rayDiagV016(tool,group,label)
  local bucket=S.v016RayDiagnostics[label]
  bucket.shots+=1
  local cam=Workspace.CurrentCamera
  if not cam then bucket.errors+=1; return {state="SEM_CAMERA",group=group} end
  local range=tool and tool:GetAttribute("range") or nil
  if type(range)~="number" or range<=0 then range=1200 end
  local rp=RaycastParams.new()
  rp.FilterType=Enum.RaycastFilterType.Exclude
  rp.IgnoreWater=true
  rp.FilterDescendantsInstances=LP.Character and {LP.Character} or {}
  local okG,eG=pcall(function() rp.CollisionGroup=group end)
  if not okG then bucket.errors+=1; return {state="ERRO_GRUPO",group=group,error=tostring(eG)} end
  local hit=nil
  local ok,e=pcall(function() hit=Workspace:Raycast(cam.CFrame.Position,cam.CFrame.LookVector*range,rp) end)
  if not ok then bucket.errors+=1; return {state="ERRO_RAY",group=group,error=tostring(e)} end
  if not hit then bucket.noHit+=1; return {state="SEM_HIT",group=group,range=range} end
  local hum=humAncestorV016(hit.Instance)
  if hum then
   bucket.character+=1
   return {state="ALVO_HUMANOIDE",group=group,path=full(hum),hitPath=full(hit.Instance),distance=(hit.Position-cam.CFrame.Position).Magnitude}
  end
  if tycoonPartV016(hit.Instance) then
   bucket.tycoon+=1
   return {state="TYCOON_PROTEGIDO",group=group,path=full(hit.Instance),distance=(hit.Position-cam.CFrame.Position).Magnitude}
  end
  bucket.other+=1
  return {state="BLOQUEADO_FORA_TYCOON",group=group,path=full(hit.Instance),class=hit.Instance.ClassName,distance=(hit.Position-cam.CFrame.Position).Magnitude,canCollide=hit.Instance:IsA("BasePart") and hit.Instance.CanCollide or nil,canQuery=hit.Instance:IsA("BasePart") and hit.Instance.CanQuery or nil}
 end

 local shotReadV014=shotRead
 shotRead=function(tool,delta)
  shotReadV014(tool,delta)
  local rec=S.shots[#S.shots]
  if not rec then return end
  local playerGroup=firstCharacterGroupV016()
  local dDefault=rayDiagV016(tool,"Default","DEFAULT")
  local dPlayer=rayDiagV016(tool,playerGroup,"PLAYER")
  rec.v016PhysicalSafeRayDiagnostics={default=dDefault,player=dPlayer,playerGroup=playerGroup}
  S.v016LastRayDiagnostics=rec.v016PhysicalSafeRayDiagnostics
  local entry=busV010 and busV010.last
  if entry and tonumber(entry.shotIndex)==tonumber(rec.index) then
   entry.v016DefaultRayState=dDefault.state
   entry.v016PlayerRayState=dPlayer.state
   entry.v016PlayerGroup=playerGroup
   entry.v016PhysicalSafetyViolations=S.v016PhysicalSafetyViolations
  end
  event("V016_SHOT_RAY_DIAGNOSTIC",{shotIndex=rec.index,defaultState=dDefault.state,playerState=dPlayer.state,playerGroup=playerGroup,physicalSafetyViolations=S.v016PhysicalSafetyViolations})
  updateUI()
 end

 local payloadV014=payload
 payload=function()
  local t=payloadV014()
  t.version=C.VERSION
  t.policy=t.policy or {}
  t.policy.mode="ALL_NON_TYCOON_PHYSICAL_SAFE_V016"
  t.policy.functionalAuthority="V0.14 ALL_NON_TYCOON preservado: somente CollisionGroup muda nas geometrias fora de Workspace.Tycoons; partes de Humanoid permanecem alvo."
  t.policy.characterPhysicsSafety="V0.16 NÃO carrega V0.15 e nunca usa supressão contínua de CanCollide/CanQuery. CanCollide e CanQuery são verificados antes/depois de cada apply/restore e restaurados se divergirem."
  t.policy.v015UniversalCorridorDisabled=true
  t.policy.v015DisableReason="CanCollide=false no corredor de mira tornou Ground/Map Parts não-colidíveis para o personagem local e causou queda do mundo."
  t.policy.rayDiagnostics="DEFAULT e grupo físico do personagem são comparados por tiro somente por leitura; nenhum diagnóstico altera o mapa."
  t.summary=t.summary or {}
  t.summary.v016PhysicalSafetyViolations=S.v016PhysicalSafetyViolations
  t.summary.v016ApplyChecks=S.v016ApplyChecks
  t.summary.v016RestoreChecks=S.v016RestoreChecks
  t.summary.v016RayDiagnostics=S.v016RayDiagnostics
  t.summary.v016LastRayDiagnostics=S.v016LastRayDiagnostics
  t.summary.v016CharacterNoclipMechanismDisabled=true
  return t
 end

 save=function()
  local ok,json=pcall(function() return HttpService:JSONEncode(payload()) end)
  if not ok then err("JSONEncode",json); return false,"Falha ao gerar JSON" end
  local name=string.format("Psicosenatico_BulletNoclip_Test_V0_16_%s_%s.json",tostring(game.PlaceId),tostring(os.time()))
  if typeof(writefile)=="function" then
   local a,b=pcall(writefile,name,json)
   if a then event("EXPORT",{method="writefile",file=name,bytes=#json}); return true,"Arquivo exportado: "..name else err("writefile",b) end
  end
  if typeof(setclipboard)=="function" then
   local a,b=pcall(setclipboard,json)
   if a then event("EXPORT",{method="clipboard",bytes=#json}); return true,"JSON copiado" else err("clipboard",b) end
  end
  return false,"Não foi possível salvar/copiar o JSON"
 end

 local updateUIV014=updateUI
 updateUI=function()
  updateUIV014()
  ver.Text=C.VERSION
  State.Text=S.enabled and "Estado: ATIVO • TUDO FORA DO TYCOON • PERSONAGEM PRESERVADO" or "Estado: DESATIVADO • restaurado"
  local d=S.v016LastRayDiagnostics
  local ds=d and d.default and d.default.state or "-"
  local ps=d and d.player and d.player.state or "-"
  Reader.Text=Reader.Text..string.format("\nV0.16 PHYSICAL SAFE\nCanCollide/CanQuery alterados: NUNCA\nViolações físicas: %d\nRay Default: %s • Ray Player: %s",S.v016PhysicalSafetyViolations,tostring(ds),tostring(ps))
 end

 local rt=ENV[C.KEY]
 if type(rt)=="table" then rt.version=C.VERSION end
end)}
if ENV.__PSICO_V016_RESULT[1]~=true then error("PSICOSENATICO V0.16 structural init: "..tostring(ENV.__PSICO_V016_RESULT[2])) end
event("V016_PHYSICAL_SAFE_READY",{allNonTycoon=true,tycoonProtected=true,humanoidTargetsExcluded=true,v015CorridorDisabled=true,writesCanCollide=false,writesCanQuery=false,preservesV014=true,version=C.VERSION})
pcall(updateUI)
