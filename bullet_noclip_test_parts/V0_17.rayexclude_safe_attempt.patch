-- V0.17 RAYEXCLUDE SAFE ATTEMPT
-- Builds on V0.16 PHYSICAL SAFE.
-- Research repeatedly observes the existing CollectionService tag "RayExclude" on equipped weapon parts.
-- V0.17 tests that game-native exclusion signal on ALL_NON_TYCOON geometry without changing CanCollide/CanQuery.
-- Workspace.Tycoons and Humanoid models are never tagged. Only tags added by this patch are removed on disable/cleanup.

local CollectionService=game:GetService("CollectionService")
C.VERSION="V0.17"
S.v017RayExcludeAdded=0
S.v017RayExcludeRemoved=0
S.v017RayExcludeAddFailed=0
S.v017RayExcludeRemoveFailed=0
S.v017RayExcludeAlreadyPresent=0
S.v017RayExcludeActive=0
S.v017RayExcludeWeaponObserved=0
S.v017AddedTags={}
S.v017PreexistingSeen={}
S.v017PolicyReverts=0

ENV.__PSICO_V017_RESULT={pcall(function()
 local TAG="RayExclude"

 local function humAncestorV017(o)
  local cur=o
  for _=1,14 do
   if not cur or cur==Workspace then break end
   if cur:IsA("Model") and cur:FindFirstChildOfClass("Humanoid") then return cur end
   cur=cur.Parent
  end
  return nil
 end

 local function tycoonProtectedV017(o)
  local t=tycoons()
  return t~=nil and o and o~=t and o:IsDescendantOf(t)
 end

 local function internalV017(o)
  local n=string.lower(tostring(o and o.Name or ""))
  return string.find(n,"__psico_",1,true)~=nil
 end

 local function eligibleV017(o)
  return o~=nil and o.Parent~=nil and o:IsA("BasePart") and not tycoonProtectedV017(o) and humAncestorV017(o)==nil and not internalV017(o)
 end

 local function hasTagV017(o)
  local ok,v=pcall(function() return CollectionService:HasTag(o,TAG) end)
  return ok and v==true
 end

 local function recalcActiveV017()
  local n=0
  for p,_ in pairs(S.v017AddedTags) do
   if p and p.Parent and hasTagV017(p) then n+=1 end
  end
  S.v017RayExcludeActive=n
  return n
 end

 local function addTagV017(p)
  if not eligibleV017(p) then return false,"NAO_ELEGIVEL" end
  if hasTagV017(p) then
   if not S.v017AddedTags[p] and not S.v017PreexistingSeen[p] then
    S.v017PreexistingSeen[p]=true
    S.v017RayExcludeAlreadyPresent+=1
   end
   return true,"JA_PRESENTE"
  end
  local before=readPartState(p)
  local ok,e=pcall(function() CollectionService:AddTag(p,TAG) end)
  local after=readPartState(p)
  local physicalSafe=before.canCollide==after.canCollide and ((not before.canQueryReadOk) or (after.canQueryReadOk and before.canQuery==after.canQuery))
  if not ok or not hasTagV017(p) or not physicalSafe then
   S.v017RayExcludeAddFailed+=1
   if hasTagV017(p) then pcall(function() CollectionService:RemoveTag(p,TAG) end) end
   if not physicalSafe then
    pcall(function() p.CanCollide=before.canCollide end)
    if before.canQueryReadOk then pcall(function() p.CanQuery=before.canQuery end) end
   end
   if S.v017RayExcludeAddFailed<=30 then event("V017_RAYEXCLUDE_ADD_FAILED",{path=full(p),error=tostring(e),physicalSafe=physicalSafe,before=before,after=after}) end
   return false,tostring(e)
  end
  S.v017AddedTags[p]=true
  S.v017RayExcludeAdded+=1
  return true,"ADICIONADA"
 end

 local function removeTagV017(p,reason)
  if not S.v017AddedTags[p] then return true end
  if not p or not p.Parent then
   S.v017AddedTags[p]=nil
   return true
  end
  local before=readPartState(p)
  local ok,e=pcall(function() CollectionService:RemoveTag(p,TAG) end)
  local after=readPartState(p)
  local physicalSafe=before.canCollide==after.canCollide and ((not before.canQueryReadOk) or (after.canQueryReadOk and before.canQuery==after.canQuery))
  local good=ok and not hasTagV017(p) and physicalSafe
  if good then
   S.v017RayExcludeRemoved+=1
  else
   S.v017RayExcludeRemoveFailed+=1
   if S.v017RayExcludeRemoveFailed<=30 then event("V017_RAYEXCLUDE_REMOVE_FAILED",{path=full(p),reason=reason,error=tostring(e),physicalSafe=physicalSafe,before=before,after=after}) end
  end
  S.v017AddedTags[p]=nil
  return good
 end

 local function removeAllV017(reason)
  local list={}
  for p,_ in pairs(S.v017AddedTags) do list[#list+1]=p end
  for _,p in ipairs(list) do removeTagV017(p,reason) end
  recalcActiveV017()
 end

 local function tagAllCandidatesV017(reason)
  local eligible=0
  local added=0
  local processed=0
  for p,_ in pairs(S.candidates) do
   if eligibleV017(p) then
    eligible+=1
    local wasOurs=S.v017AddedTags[p]==true
    local ok,why=addTagV017(p)
    if ok and why=="ADICIONADA" and not wasOurs then added+=1 end
   end
   processed+=1
   if processed%350==0 then task.wait() end
  end
  recalcActiveV017()
  event("V017_RAYEXCLUDE_SCAN",{reason=reason,eligible=eligible,added=added,active=S.v017RayExcludeActive,alreadyPresent=S.v017RayExcludeAlreadyPresent,failures=S.v017RayExcludeAddFailed})
  return added,eligible
 end

 local function inspectWeaponTagsV017()
  local seen={}
  local n=0
  local roots={LP.Character,LP:FindFirstChildOfClass("Backpack")}
  for _,root in ipairs(roots) do
   if root then
    for _,d in ipairs(root:GetDescendants()) do
     if d:IsA("BasePart") and hasTagV017(d) and not seen[d] then
      seen[d]=true
      n+=1
     end
    end
   end
  end
  S.v017RayExcludeWeaponObserved=n
  return n
 end

 local registerV016=register
 register=function(p,info)
  local out=registerV016(p,info)
  if S.enabled and p and S.candidates[p] and eligibleV017(p) then addTagV017(p) end
  return out
 end

 local setEnabledV016=setEnabled
 setEnabled=function(v,reason)
  if not v then removeAllV017("NOCLIP_OFF_PRE") end
  setEnabledV016(v,reason)
  if v and S.enabled then
   inspectWeaponTagsV017()
   tagAllCandidatesV017("NOCLIP_ON")
   S.last=string.format("V0.17 ATIVO • %s • RayExclude %d • física preservada",tostring(S.v08SelectedPassGroup),S.v017RayExcludeActive)
   event("V017_RAYEXCLUDE_ON",{active=S.v017RayExcludeActive,weaponTaggedPartsObserved=S.v017RayExcludeWeaponObserved,selectedGroup=S.v08SelectedPassGroup})
  end
  updateUI()
 end

 -- If a Humanoid is added after its Parts, immediately remove any tag this patch may have added to that model.
 S.conns[#S.conns+1]=Workspace.DescendantAdded:Connect(function(o)
  if o:IsA("Humanoid") then
   task.defer(function()
    local model=o.Parent
    if not model then return end
    for _,d in ipairs(model:GetDescendants()) do
     if d:IsA("BasePart") and S.v017AddedTags[d] then
      S.v017PolicyReverts+=1
      removeTagV017(d,"HUMANOID_APPEARED")
     end
    end
   end)
  end
 end)

 -- Rotating policy guard. Never writes physical properties.
 S.v017GuardCursor=0
 S.v017GuardAcc=0
 S.conns[#S.conns+1]=RunService.Heartbeat:Connect(function()
  if S.closed or not S.enabled then return end
  S.v017GuardAcc+=1
  if S.v017GuardAcc<150 then return end
  S.v017GuardAcc=0
  local total=#S.order
  if total==0 then return end
  for step=1,math.min(64,total) do
   local idx=((S.v017GuardCursor+step-1)%total)+1
   local p=S.order[idx]
   if p and S.v017AddedTags[p] and not eligibleV017(p) then
    S.v017PolicyReverts+=1
    removeTagV017(p,"POLICY_GUARD")
   end
  end
  S.v017GuardCursor=(S.v017GuardCursor+64)%math.max(total,1)
  recalcActiveV017()
 end)

 local shotReadV016=shotRead
 shotRead=function(tool,delta)
  shotReadV016(tool,delta)
  local rec=S.shots[#S.shots]
  if not rec then return end
  rec.v017RayExclude={
   tag=TAG,
   active=S.v017RayExcludeActive,
   addedTotal=S.v017RayExcludeAdded,
   addFailures=S.v017RayExcludeAddFailed,
   weaponTaggedPartsObserved=S.v017RayExcludeWeaponObserved,
   physicalSafetyViolations=S.v016PhysicalSafetyViolations
  }
  local entry=busV010 and busV010.last
  if entry and tonumber(entry.shotIndex)==tonumber(rec.index) then
   entry.v017RayExcludeActive=S.v017RayExcludeActive
   entry.v017RayExcludeAdded=S.v017RayExcludeAdded
   entry.v017WeaponTaggedPartsObserved=S.v017RayExcludeWeaponObserved
  end
 end

 local cleanupV016=cleanup
 cleanup=function()
  removeAllV017("CLEANUP")
  cleanupV016()
 end
 local rt=ENV[C.KEY]
 if type(rt)=="table" then rt.cleanup=cleanup; rt.version=C.VERSION end

 local payloadV016=payload
 payload=function()
  local t=payloadV016()
  t.version=C.VERSION
  t.policy=t.policy or {}
  t.policy.mode="ALL_NON_TYCOON_PHYSICAL_SAFE_PLUS_RAYEXCLUDE_V017"
  t.policy.rayExcludeHypothesis="Research observou a tag RayExclude em partes das armas. V0.17 adiciona essa MESMA tag somente a BaseParts fora de Workspace.Tycoons e fora de Models com Humanoid para testar se o BlasterSystem a usa no filtro interno. É uma hipótese funcional, não prova de implementação interna."
  t.policy.rayExcludePhysicalSafety="Adicionar/remover RayExclude nunca deve alterar CanCollide ou CanQuery; V0.16 continua verificando a física."
  t.policy.protected={"Workspace.Tycoons"}
  t.summary=t.summary or {}
  t.summary.v017RayExcludeAdded=S.v017RayExcludeAdded
  t.summary.v017RayExcludeRemoved=S.v017RayExcludeRemoved
  t.summary.v017RayExcludeActive=S.v017RayExcludeActive
  t.summary.v017RayExcludeAddFailed=S.v017RayExcludeAddFailed
  t.summary.v017RayExcludeRemoveFailed=S.v017RayExcludeRemoveFailed
  t.summary.v017RayExcludeAlreadyPresent=S.v017RayExcludeAlreadyPresent
  t.summary.v017RayExcludeWeaponObserved=S.v017RayExcludeWeaponObserved
  t.summary.v017PolicyReverts=S.v017PolicyReverts
  t.summary.v017PhysicalSafetyViolations=S.v016PhysicalSafetyViolations
  return t
 end

 save=function()
  local ok,json=pcall(function() return HttpService:JSONEncode(payload()) end)
  if not ok then err("JSONEncode",json); return false,"Falha ao gerar JSON" end
  local name=string.format("Psicosenatico_BulletNoclip_Test_V0_17_%s_%s.json",tostring(game.PlaceId),tostring(os.time()))
  if typeof(writefile)=="function" then
   local a,b=pcall(writefile,name,json)
   if a then event("EXPORT",{method="writefile",file=name,bytes=#json}); return true,"Arquivo exportado: "..name else err("writefile",b) end
  end
  if typeof(setclipboard)=="function" then
   local a,b=pcall(setclipboard,json)
   if a then event("EXPORT",{method="clipboard",bytes=#json}); return true,"JSON copiado" else err("clipboard",b) end
  end
  return false,"Não foi possível salvar/copiar o JSON"
 end

 local updateUIV016=updateUI
 updateUI=function()
  updateUIV016()
  ver.Text=C.VERSION
  State.Text=S.enabled and "Estado: ATIVO • TUDO FORA DO TYCOON • RAYEXCLUDE SAFE" or "Estado: DESATIVADO • restaurado"
  Reader.Text=Reader.Text..string.format("\nV0.17 RAYEXCLUDE SAFE\nTag ativa: %d • adicionadas: %d • falhas: %d\nRayExclude já visto na arma: %d • violações físicas: %d",S.v017RayExcludeActive,S.v017RayExcludeAdded,S.v017RayExcludeAddFailed,S.v017RayExcludeWeaponObserved,S.v016PhysicalSafetyViolations)
 end
end)}
if ENV.__PSICO_V017_RESULT[1]~=true then error("PSICOSENATICO V0.17 structural init: "..tostring(ENV.__PSICO_V017_RESULT[2])) end
event("V017_RAYEXCLUDE_SAFE_READY",{allNonTycoon=true,tycoonProtected=true,humanoidTargetsExcluded=true,writesCanCollide=false,writesCanQuery=false,rayExcludeTag="RayExclude",preservesV016=true,version=C.VERSION})
pcall(updateUI)
