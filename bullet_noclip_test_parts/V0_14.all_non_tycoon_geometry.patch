-- V0.14 ALL NON-TYCOON GEOMETRY
-- Functional authority: every physical BasePart outside Workspace.Tycoons is pass-through.
-- Humanoid character parts are excluded so players/bots remain valid bullet targets.
-- Keeps the proven V0.8 existing CollisionGroup mechanism; no group registration/matrix edits.

C.VERSION="V0.14"
S.v014Registered=0
S.v014TycoonProtectedSeen=0
S.v014HumanoidExcludedSeen=0
S.v014InternalExcludedSeen=0
S.v014ApplyFailures=0
S.v014PersistenceSamples=0
S.v014GroupReverts=0
S.v014CompactSamples={}
S.v014TycoonSeenSet={}
S.v014HumanoidSeenSet={}
S.v014InternalSeenSet={}
S.v014SampleCursor=0

ENV.__PSICO_V014_RESULT={pcall(function()
 local function humanoidAncestorV014(o)
  local cur=o
  for _=1,14 do
   if not cur or cur==Workspace then break end
   if cur:IsA("Model") and cur:FindFirstChildOfClass("Humanoid") then return cur end
   cur=cur.Parent
  end
  return nil
 end

 local function tycoonProtectedV014(o)
  local t=tycoons()
  return t~=nil and o~=t and o:IsDescendantOf(t)
 end

 local function internalV014(o)
  local n=string.lower(tostring(o and o.Name or ""))
  return string.find(n,"__psico_",1,true)~=nil
 end

 local function markUniqueV014(set,key,counter)
  if key and not set[key] then
   set[key]=true
   S[counter]=(S[counter] or 0)+1
  end
 end

 local function functionalPolicyV014(o)
  if not o or not o:IsA("BasePart") then return "NAO_GEOMETRIA",nil end
  if tycoonProtectedV014(o) then
   markUniqueV014(S.v014TycoonSeenSet,o,"v014TycoonProtectedSeen")
   return "TYCOON_PROTEGIDO","Workspace.Tycoons"
  end
  local hum=humanoidAncestorV014(o)
  if hum then
   markUniqueV014(S.v014HumanoidSeenSet,o,"v014HumanoidExcludedSeen")
   return "ALVO_HUMANOIDE",full(hum)
  end
  if internalV014(o) then
   markUniqueV014(S.v014InternalSeenSet,o,"v014InternalExcludedSeen")
   return "INTERNO_PSICO",o.Name
  end
  return "ATRAVESSAR",nil
 end

 classify=function(p)
  local policy,why=functionalPolicyV014(p)
  if policy~="ATRAVESSAR" then return nil,why or policy end
  local s=nil
  local okS,size=pcall(function() return p.Size end)
  if okS and size then s={size.X,size.Y,size.Z} end
  return {
   kind="NON_TYCOON_GEOMETRY",
   reason="V0.14: toda geometria fora de Workspace.Tycoons deve ser ignorada pelo raycast local",
   marker=full(p),
   shape={profile="ALL_NON_TYCOON",size=s},
   functionalPolicy="ATRAVESSAR"
  }
 end

 -- Broad registration replaces wall-shape registration. Successes are intentionally compact:
 -- thousands of map parts must not create thousands of event records just for being indexed.
 local oldRegisterV013=register
 register=function(p,info)
  if not p or not p.Parent then return false end
  if S.candidates[p] then return false end
  if not info or info.kind~="NON_TYCOON_GEOMETRY" then return oldRegisterV013(p,info) end
  local baseline=readPartState(p)
  if not baseline.canQueryReadOk or baseline.collisionGroup==nil then
   S.v014ApplyFailures+=1
   if S.v014ApplyFailures<=25 then event("V014_REGISTER_UNSUPPORTED",{path=full(p),state=baseline}) end
   return false
  end
  local meta={
   path=full(p),name=p.Name,class=p.ClassName,kind=info.kind,reason=info.reason,marker=info.marker,shape=info.shape,
   originalCanQuery=baseline.canQuery,originalCollisionGroup=baseline.collisionGroup,baselineState=baseline,
   debugId=baseline.debugId,applied=false,v014FunctionalPolicy="ATRAVESSAR"
  }
  S.candidates[p]=meta
  S.order[#S.order+1]=p
  S.counts[info.kind]=(S.counts[info.kind] or 0)+1
  S.v014Registered+=1
  if #S.v014CompactSamples<40 then
   S.v014CompactSamples[#S.v014CompactSamples+1]={path=meta.path,group=baseline.collisionGroup,canCollide=baseline.canCollide,canQuery=baseline.canQuery,size=info.shape and info.shape.size or nil}
  end
  if S.enabled then apply(p,meta) end
  return true
 end

 scan=function(reason)
  local added=0
  local eligible=0
  local okDesc,desc=pcall(function() return Workspace:GetDescendants() end)
  if not okDesc or type(desc)~="table" then
   event("V014_SCAN_FAILED",{reason=reason,error=tostring(desc)})
   return 0
  end
  for i,o in ipairs(desc) do
   if o:IsA("BasePart") then
    local info=classify(o)
    if info then
     eligible+=1
     if register(o,info) then added+=1 end
    end
   end
   if i%750==0 then task.wait() end
  end
  event("V014_SCAN",{reason=reason,added=added,eligible=eligible,total=#S.order,tycoonProtected=S.v014TycoonProtectedSeen,humanoidExcluded=S.v014HumanoidExcludedSeen})
  return added
 end

 -- V0.8 required CanCollide=true because it only handled wall candidates.
 -- V0.14 preserves the original CanCollide/CanQuery values and validates only that the
 -- existing pass group was applied without silently changing those properties.
 apply=function(p,meta)
  if not p or not p.Parent or not S.groupStrategyReady or not S.v08SelectedPassGroup then return false end
  local policy=functionalPolicyV014(p)
  if policy~="ATRAVESSAR" then return false end
  local before=readPartState(p)
  if meta.originalCollisionGroup==nil then meta.originalCollisionGroup=before.collisionGroup or "Default" end
  if meta.originalCanQuery==nil and before.canQueryReadOk then meta.originalCanQuery=before.canQuery end
  local okG,eG=pcall(function() p.CollisionGroup=S.v08SelectedPassGroup end)
  local after=readPartState(p)
  local sameCollide=(before.canCollide==after.canCollide)
  local sameQuery=(not before.canQueryReadOk) or (after.canQueryReadOk and before.canQuery==after.canQuery)
  meta.lastApplyBefore=before
  meta.lastApplyAfter=after
  meta.v08PassGroup=S.v08SelectedPassGroup
  meta.v014FunctionalPolicy="ATRAVESSAR"
  meta.groupApplied=okG and after.collisionGroup==S.v08SelectedPassGroup and sameCollide and sameQuery
  meta.applyVerified=meta.groupApplied
  meta.applied=meta.groupApplied
  if meta.applied then
   S.applyVerified+=1
   S.groupApplied=(S.groupApplied or 0)+1
  else
   S.applyVerifyFailed+=1
   S.groupApplyFailed=(S.groupApplyFailed or 0)+1
   S.v014ApplyFailures+=1
   if S.v014ApplyFailures<=40 then
    event("V014_GROUP_APPLY_FAILED",{path=meta.path,before=before,after=after,selectedGroup=S.v08SelectedPassGroup,groupWriteOk=okG,groupError=tostring(eG),sameCanCollide=sameCollide,sameCanQuery=sameQuery})
   end
  end
  return meta.applied
 end

 local function eligibleCountV014()
  local n=0
  for p,_ in pairs(S.candidates) do
   if p and p.Parent and functionalPolicyV014(p)=="ATRAVESSAR" then n+=1 end
  end
  return n
 end

 setEnabled=function(v,reason)
  if S.closed or S.enabled==v then return end
  if v then
   scan("V014_ENABLE_ALL_NON_TYCOON")
   local ok,why=prepareExistingGroupStrategyV08()
   if not ok then
    S.last="V0.14 BLOQUEADO • "..tostring(why)
    updateUI()
    return
   end
   S.enabled=true
   local changed=0
   local protectedNow=0
   local processed=0
   for p,m in pairs(S.candidates) do
    if p and p.Parent then
     local policy=functionalPolicyV014(p)
     if policy=="ATRAVESSAR" then
      if not m.applied and apply(p,m) then changed+=1 end
     else
      protectedNow+=1
      if m.applied then restore(p,m) end
      m.v014FunctionalPolicy=policy
     end
     processed+=1
     if processed%350==0 then task.wait() end
    end
   end
   local eligible=eligibleCountV014()
   if changed==0 and eligible>0 then
    S.enabled=false
    S.groupStrategyReady=false
    S.groupStrategyBlockedReason="GRUPO_COMPATIVEL_ENCONTRADO_MAS_NENHUMA_GEOMETRIA_ACEITOU_O_GRUPO"
    S.last="V0.14 BLOQUEADO • "..S.groupStrategyBlockedReason
    event("V014_APPLY_ZERO",{selectedGroup=S.v08SelectedPassGroup,eligible=eligible})
   else
    S.last=string.format("V0.14 ATIVO • %s • %d geometrias fora do Tycoon",tostring(S.v08SelectedPassGroup),eligible)
    event("NOCLIP_ON",{reason=reason,changed=changed,eligible=eligible,protectedNow=protectedNow,mechanism="ALL_NON_TYCOON_EXISTING_COLLISION_GROUP",selectedGroup=S.v08SelectedPassGroup})
   end
  else
   S.enabled=false
   local restored=0
   local processed=0
   for p,m in pairs(S.candidates) do
    if p and p.Parent and m.applied and restore(p,m) then restored+=1 end
    processed+=1
    if processed%350==0 then task.wait() end
   end
   S.last=string.format("V0.14 DESATIVADO • restauradas %d geometrias",restored)
   event("NOCLIP_OFF",{reason=reason,changed=restored,total=#S.order,mechanism="ALL_NON_TYCOON_EXISTING_COLLISION_GROUP"})
  end
  updateUI()
 end

 local function refreshPartV014(o,reason)
  if S.closed or not o or not o:IsA("BasePart") then return end
  local policy=functionalPolicyV014(o)
  local meta=S.candidates[o]
  if policy=="ATRAVESSAR" then
   if not meta then
    local info=classify(o)
    if info and register(o,info) then meta=S.candidates[o] end
   end
   if S.enabled and meta and not meta.applied then apply(o,meta) end
  elseif meta then
   meta.v014FunctionalPolicy=policy
   if meta.applied then
    restore(o,meta)
    event("V014_RESTORED_AFTER_POLICY_CHANGE",{path=meta.path,reason=reason,policy=policy})
   end
  end
 end

 -- Covers geometry created after startup, including map pieces outside Workspace.Map.
 S.conns[#S.conns+1]=Workspace.DescendantAdded:Connect(function(o)
  if o:IsA("BasePart") then task.defer(function() refreshPartV014(o,"WORKSPACE_DESCENDANT_ADDED") end) end
 end)

 -- Lightweight rotating verification; avoids V0.8's 3 delayed tasks PER part on a full map.
 S.conns[#S.conns+1]=RunService.Heartbeat:Connect(function()
  if S.closed or not S.enabled then return end
  S.v014HeartbeatAcc=(S.v014HeartbeatAcc or 0)+1
  if S.v014HeartbeatAcc<120 then return end
  S.v014HeartbeatAcc=0
  local checked=0
  local start=S.v014SampleCursor
  local total=#S.order
  if total==0 then return end
  for step=1,math.min(48,total) do
   local idx=((start+step-1)%total)+1
   local p=S.order[idx]
   local m=p and S.candidates[p]
   if p and p.Parent and m and m.applied then
    local policy=functionalPolicyV014(p)
    if policy~="ATRAVESSAR" then
     restore(p,m)
     event("V014_POLICY_GUARD_RESTORE",{path=m.path,policy=policy})
    else
     local st=readPartState(p)
     S.v014PersistenceSamples+=1
     if st.collisionGroup~=S.v08SelectedPassGroup then
      S.v014GroupReverts+=1
      event("V014_GROUP_REVERTED",{path=m.path,expected=S.v08SelectedPassGroup,state=st})
     end
    end
    checked+=1
   end
  end
  S.v014SampleCursor=(start+math.max(checked,1))%total
 end)

 local oldPayloadV013=payload
 payload=function()
  local t=oldPayloadV013()
  t.version=C.VERSION
  t.policy=t.policy or {}
  t.policy.mode="ALL_NON_TYCOON_GEOMETRY_V014"
  t.policy.functionalAuthority="ATRAVESSAR toda BasePart de Workspace que NÃO seja descendente de Workspace.Tycoons; excluir partes de Models com Humanoid para que players/bots continuem sendo alvos."
  t.policy.protected={"Workspace.Tycoons"}
  t.policy.noLongerProtectedByFunctionalRule={"Ground","Mountain","TerrainPart Parts","TeamColors/Spawn","CombatObstacles","Map genérico","ForceField/SmoothPlastic de barreira de time","paredes finas","paredes grossas","geometria fora de Workspace.Map"}
  t.policy.mechanism="Existing CollisionGroup empírico da V0.8; preserva CanCollide e CanQuery originais e altera somente CollisionGroup enquanto ativo."
  t.policy.diagnosticClassifierOnly="Categorias NAMED_WALL/SHAPE_WALL/normalWall permanecem apenas para compatibilidade diagnóstica; não limitam a cobertura funcional V0.14."
  t.summary=t.summary or {}
  t.summary.v014Registered=S.v014Registered
  t.summary.v014EligibleNow=eligibleCountV014()
  t.summary.v014TycoonProtectedSeen=S.v014TycoonProtectedSeen
  t.summary.v014HumanoidExcludedSeen=S.v014HumanoidExcludedSeen
  t.summary.v014InternalExcludedSeen=S.v014InternalExcludedSeen
  t.summary.v014ApplyFailures=S.v014ApplyFailures
  t.summary.v014PersistenceSamples=S.v014PersistenceSamples
  t.summary.v014GroupReverts=S.v014GroupReverts
  t.summary.v014FunctionalRule="ALL_NON_TYCOON"
  t.v014CompactSamples=S.v014CompactSamples
  -- Full candidate dumps become extremely large under whole-map coverage. Keep legacy
  -- 128-candidate diagnostics in events/history, but export only compact V0.14 samples.
  t.candidates=nil
  return t
 end

 save=function()
  local ok,json=pcall(function() return HttpService:JSONEncode(payload()) end)
  if not ok then err("JSONEncode",json); return false,"Falha ao gerar JSON" end
  local name=string.format("Psicosenatico_BulletNoclip_Test_V0_14_%s_%s.json",tostring(game.PlaceId),tostring(os.time()))
  if typeof(writefile)=="function" then
   local a,b=pcall(writefile,name,json)
   if a then event("EXPORT",{method="writefile",file=name,bytes=#json}); return true,"Arquivo exportado: "..name else err("writefile",b) end
  end
  if typeof(setclipboard)=="function" then
   local a,b=pcall(setclipboard,json)
   if a then event("EXPORT",{method="clipboard",bytes=#json}); return true,"JSON copiado" else err("clipboard",b) end
  end
  return false,"Não foi possível salvar/copiar o JSON"
 end

 local oldUpdateUIV013=updateUI
 updateUI=function()
  oldUpdateUIV013()
  ver.Text=C.VERSION
  State.Text=S.enabled and "Estado: ATIVO • TUDO FORA DO TYCOON" or "Estado: DESATIVADO • restaurado"
  local eligible=0
  if S.enabled then eligible=eligibleCountV014() end
  Stats.Text=string.format("Cobertura: %s • Fora Tycoon: %d • Tiros: %d",S.enabled and "TOTAL" or "aguardando ativação",eligible,#S.shots)
  Reader.Text=string.gsub(Reader.Text,"Leitor V0%.13","Leitor V0.14")
  Reader.Text=Reader.Text..string.format("\nV0.14: ALL NON-TYCOON\nElegíveis: %d • Tycoon preservado: %d\nFalhas aplicação: %d • reversões: %d",eligible,S.v014TycoonProtectedSeen,S.v014ApplyFailures,S.v014GroupReverts)
 end

 local rt=ENV[C.KEY]
 if type(rt)=="table" then rt.version=C.VERSION end
end)}
if ENV.__PSICO_V014_RESULT[1]~=true then error("PSICOSENATICO V0.14 structural init: "..tostring(ENV.__PSICO_V014_RESULT[2])) end
event("V014_ALL_NON_TYCOON_READY",{allNonTycoon=true,tycoonOnlyProtected=true,humanoidTargetsExcluded=true,preservesV08Mechanism=true,compactDiagnostics=true,version=C.VERSION})
pcall(updateUI)
