-- V2.3.12 POST-RUN DIAGNOSTIC HOTFIX • STRUCTURAL-SAFE
-- Fixes two observational issues found in the first successful V2.3.12 runtime:
-- 1) Handle origin must resolve nested Tool.Model.Handle / canonical MuzzleAttachment parent.
-- 2) A matched NoClip shared-bus record is authoritative for clientReachedCharacter on free/non-barrier shots too.
-- No gameplay, RemoteEvent, CollisionGroup, CanQuery, CanCollide or PlayerOnly behavior is changed.

S.V2312PostRunHotfix=true
S.V2312NestedHandleResolved=0
S.V2312NestedHandleMissing=0
S.V2312ClientAuthorityCorrected=0
S.V2312PostRunHotfixErrors=0

ENV.__PSICO_V2312_POSTRUN_RESULT={pcall(function()
 local function safePath2312h(inst)
  if not inst then return nil end
  local ok,v=pcall(function() return full(inst) end)
  return ok and v or tostring(inst)
 end

 local function safeId2312h(inst)
  if not inst then return nil end
  local ok,v=pcall(function() return inst:GetDebugId(0) end)
  return ok and tostring(v) or nil
 end

 local function vec2312h(v)
  if typeof(v)=="Vector3" then return {v.X,v.Y,v.Z} end
  return nil
 end

 local function muzzleScore2312h(inst)
  if not inst then return 0 end
  local n=string.lower(tostring(inst.Name or ""))
  local score=0
  if n=="muzzleattachment" or n=="muzzle" then score=120
  elseif string.find(n,"muzzle",1,true) then score=110
  elseif n=="firepoint" or n=="shootpoint" then score=100
  elseif string.find(n,"firepoint",1,true) or string.find(n,"shootpoint",1,true) then score=95
  elseif string.find(n,"fireattachment",1,true) or string.find(n,"shootorigin",1,true) or string.find(n,"shotorigin",1,true) then score=90
  elseif string.find(n,"barrel",1,true) then score=75 end
  if inst:IsA("Attachment") then score+=5 end
  return score
 end

 local function resolveNestedHandle2312h(tool)
  if not tool then return nil,"TOOL_AUSENTE" end
  local direct=tool:FindFirstChild("Handle")
  if direct and direct:IsA("BasePart") then return direct,"DIRECT_TOOL_HANDLE" end
  local bestMuzzle=nil
  local bestScore=-1
  for _,d in ipairs(tool:GetDescendants()) do
   if d:IsA("Attachment") or d:IsA("BasePart") then
    local sc=muzzleScore2312h(d)
    if sc>bestScore then bestScore=sc;bestMuzzle=d end
   end
  end
  if bestMuzzle and bestScore>0 then
   local p=bestMuzzle.Parent
   if p and p:IsA("BasePart") then return p,"CANONICAL_MUZZLE_PARENT" end
   local a=bestMuzzle:FindFirstAncestorWhichIsA("BasePart")
   if a then return a,"CANONICAL_MUZZLE_ANCESTOR" end
  end
  for _,d in ipairs(tool:GetDescendants()) do
   if d:IsA("BasePart") and string.lower(d.Name)=="handle" then return d,"NESTED_NAMED_HANDLE" end
  end
  return nil,"HANDLE_NAO_ENCONTRADO"
 end

 local function scopeHit2312h(inst)
  if not inst then return nil,nil end
  local model=inst:FindFirstAncestorOfClass("Model")
  local hum=model and model:FindFirstChildOfClass("Humanoid") or nil
  if hum then return "PERSONAGEM",model end
  local scope=nil
  pcall(function() scope=hierarchyScope(inst,explicitBlockInfo(inst)) end)
  return scope,model
 end

 local function compactHit2312h(result,origin)
  if not result then return nil end
  local inst=result.Instance
  local scope,model=scopeHit2312h(inst)
  return {
   path=safePath2312h(inst),name=inst and inst.Name or nil,class=inst and inst.ClassName or nil,
   debugId=safeId2312h(inst),model=model and safePath2312h(model) or nil,
   hasHumanoid=scope=="PERSONAGEM",structureScope=scope,
   distance=(result.Position-origin).Magnitude,position=vec2312h(result.Position),
   material=tostring(result.Material),collisionGroup=inst and inst:IsA("BasePart") and inst.CollisionGroup or nil
  }
 end

 local function nearestCandidate2312h(origin,unit,maxDistance)
  local best=nil
  for _,candidate in ipairs(S.GeometryCandidates or {}) do
   local part=candidate.part
   if part and part.Parent then
    local d=rayObbDistance(origin,unit,maxDistance,part)
    if d and d>=0 and (not best or d<best.distance) then
     best={distance=d,path=candidate.path or safePath2312h(part),subtype=candidate.subtype,reason=candidate.reason,debugId=safeId2312h(part),size=vec2312h(part.Size),collisionGroup=part.CollisionGroup,canCollide=part.CanCollide,canQuery=part.CanQuery}
    end
   end
  end
  return best
 end

 local function targetProjection2312h(origin,unit,targetModel)
  if not targetModel or not targetModel.Parent then return nil,nil,nil end
  local root=targetModel:FindFirstChild("HumanoidRootPart") or targetModel.PrimaryPart or targetModel:FindFirstChild("Head")
  if not root or not root:IsA("BasePart") then return nil,nil,nil end
  local delta=root.Position-origin
  local along=delta:Dot(unit)
  local closest=origin+unit*along
  return along,(root.Position-closest).Magnitude,root.Position
 end

 local function handleRay2312h(origin,unit,maxDistance,targetModel)
  local excluded={}
  if Workspace.CurrentCamera then excluded[#excluded+1]=Workspace.CurrentCamera end
  if LP.Character then excluded[#excluded+1]=LP.Character end
  local currentOrigin=origin
  local travelled=0
  local firstHit=nil
  local firstCharacter=nil
  local chain={}
  for index=1,6 do
   local remaining=maxDistance-travelled
   if remaining<=0.02 then break end
   local params=RaycastParams.new()
   params.FilterType=Enum.RaycastFilterType.Exclude
   params.FilterDescendantsInstances=excluded
   params.IgnoreWater=false
   local ok,result=pcall(function() return Workspace:Raycast(currentOrigin,unit*remaining,params) end)
   if not ok then return {ok=false,error=tostring(result),origin=vec2312h(origin)} end
   if not result then break end
   local h=compactHit2312h(result,origin)
   h.chainIndex=index
   chain[#chain+1]=h
   if not firstHit then firstHit=h end
   if h.hasHumanoid then firstCharacter=h;break end
   excluded[#excluded+1]=result.Instance
   travelled=(result.Position-origin).Magnitude+0.03
   currentOrigin=result.Position+unit*0.03
  end
  local candidate=nearestCandidate2312h(origin,unit,maxDistance)
  local td,lat,tp=targetProjection2312h(origin,unit,targetModel)
  return {ok=true,origin=vec2312h(origin),firstHit=firstHit,firstCharacter=firstCharacter,chain=chain,chainCount=#chain,nearestCandidate=candidate,targetProjectionDistance=td,targetLateralDistance=lat,targetRootPosition=vec2312h(tp),targetBehindCandidate=(candidate and td and td>candidate.distance+0.03) or false}
 end

 local function angleDeg2312h(a,b)
  if type(a)~="table" or type(b)~="table" then return nil end
  local va=Vector3.new(a[1] or 0,a[2] or 0,a[3] or 0)
  local vb=Vector3.new(b[1] or 0,b[2] or 0,b[3] or 0)
  if va.Magnitude<=0 or vb.Magnitude<=0 then return nil end
  local dot=math.clamp(va.Unit:Dot(vb.Unit),-1,1)
  return math.deg(math.acos(dot))
 end

 local function augmentOrigin2312h(shot,locked,tool)
  local study=shot and shot.originStudyV2312
  local ref=shot and shot.referenceRay
  if type(study)~="table" or not ref or type(ref.origin)~="table" or type(ref.direction)~="table" then return end
  local handle,source=resolveNestedHandle2312h(tool)
  study.handleResolutionV2312Hotfix={source=source,path=handle and safePath2312h(handle) or nil}
  if not handle then S.V2312NestedHandleMissing+=1;return end
  local direction=Vector3.new(ref.direction[1] or 0,ref.direction[2] or 0,ref.direction[3] or 0)
  if direction.Magnitude<=0 then S.V2312NestedHandleMissing+=1;return end
  local unit=direction.Unit
  local maxDistance=tonumber(ref.range) or direction.Magnitude
  local targetModel=locked and locked.targetModel or nil
  local result=handleRay2312h(handle.Position,unit,maxDistance,targetModel)
  result.sourceInstance={path=safePath2312h(handle),name=handle.Name,class=handle.ClassName,position=vec2312h(handle.Position),collisionGroup=handle.CollisionGroup,canCollide=handle.CanCollide,canQuery=handle.CanQuery,material=tostring(handle.Material)}
  result.resolutionSource=source
  study.origins=study.origins or {}
  study.origins.TOOL_HANDLE_ORIGIN=result
  study.handleKey="TOOL_HANDLE_ORIGIN"
  study.originOrder=study.originOrder or {}
  local exists=false
  for _,k in ipairs(study.originOrder) do if k=="TOOL_HANDLE_ORIGIN" then exists=true break end end
  if not exists then table.insert(study.originOrder,3,"TOOL_HANDLE_ORIGIN") end
  study.comparisons=study.comparisons or {}
  local camOrigin=Vector3.new(ref.origin[1] or 0,ref.origin[2] or 0,ref.origin[3] or 0)
  study.comparisons.cameraToHandleDistance=(handle.Position-camOrigin).Magnitude
  local camPath=study.camera and study.camera.firstHit and study.camera.firstHit.path or nil
  local handlePath=result.firstHit and result.firstHit.path or nil
  study.comparisons.cameraRayVsHandleRayDiverged=(camPath~=handlePath)
  study.comparisons.handleRayFirstHit=result.firstHit
  study.comparisons.handleToWallEntry=result.nearestCandidate and result.nearestCandidate.distance or nil
  study.comparisons.handleToTargetDistance=result.targetProjectionDistance
  study.comparisons.handleRayTargetBehindWall=result.targetBehindCandidate
  local mk=study.canonicalMuzzleKey
  local muzzle=mk and study.origins and study.origins[mk] or nil
  local axis=muzzle and muzzle.sourceInstance and muzzle.sourceInstance.worldAxis or nil
  study.comparisons.muzzleWorldAxisAngleToReferenceDeg=angleDeg2312h(axis,study.directionUnit)
  S.V2312NestedHandleResolved+=1
 end

 local function hpEvidence2312h(shot)
  local p=shot and shot.damageProbe
  if p then
   local dmg=tonumber(p.observedDamage) or 0
   if p.reliable==true and p.status=="QUEDA_DE_HP_OBSERVADA" and dmg>0.001 then return "DANO_CONFIRMADO",dmg,"DAMAGE_PROBE_RELIABLE" end
  end
  local d=shot and shot.interShotHealthDelta
  local inter=tonumber(d and d.observedDamage) or 0
  if inter>0.001 then return "DANO_OBSERVADO_CORRELACIONADO",inter,"INTERSHOT_CORRELATION" end
  if p and p.reliable==true and p.status=="SEM_QUEDA_DE_HP_OBSERVADA" then return "SEM_QUEDA_HP_CONFIAVEL",0,"DAMAGE_PROBE_RELIABLE" end
  return "DANO_AMBIGUO",0,"NO_RELIABLE_HP_RESULT"
 end

 local function recomputeClient2312h(shot)
  if not shot then return end
  local sync=shot.noClipSync
  local isBarrier=shot.barrierBetweenCameraAndTargetV2311==true or shot.wallDiagnosticCategory=="BARREIRA_PROTECAO_TIME"
  local client=nil
  local authority=nil
  if sync and sync.matched==true then
   authority="NOCLIP_SHARED_BUS_V2312_HOTFIX"
   if isBarrier and sync.teamBarrierClientState then client=sync.teamBarrierClientState
   elseif sync.clientReachedCharacter==true then client="CLIENTE_ATINGIU_ALVO"
   elseif sync.crossedCandidate==true then client="CLIENTE_NAO_ATINGIU_ALVO"
   else client="CLIENTE_NAO_ATINGIU_ALVO" end
  else
   client=shot.clientPathStateV239
   authority=shot.clientPathAuthorityV239 or "RESEARCH_FALLBACK"
  end
  local hp,dmg,hps=hpEvidence2312h(shot)
  local outcome=nil
  if isBarrier then
   if client=="CLIENTE_ATINGIU_ALVO" then
    if hp=="DANO_CONFIRMADO" then outcome="DANO_CONFIRMADO"
    elseif hp=="DANO_OBSERVADO_CORRELACIONADO" then outcome="DANO_OBSERVADO_CORRELACIONADO"
    elseif hp=="SEM_QUEDA_HP_CONFIAVEL" then outcome="CLIENTE_ATINGE_SERVIDOR_NEGA"
    else outcome="CLIENTE_ATINGE_RESULTADO_AMBIGUO" end
   elseif client=="CLIENTE_PAROU_NA_BARREIRA" or client=="CLIENTE_BLOQUEADO_ANTES_DO_ALVO" then outcome="CLIENTE_BLOQUEADO"
   elseif string.find(tostring(client),"PASSOU",1,true) then outcome="CLIENTE_PASSOU_SEM_ALVO"
   else outcome="SEM_ALVO_PARA_VALIDAR" end
  else
   if client=="CLIENTE_ATINGIU_ALVO" then
    if hp=="DANO_CONFIRMADO" then outcome="DANO_CONFIRMADO"
    elseif hp=="DANO_OBSERVADO_CORRELACIONADO" then outcome="DANO_OBSERVADO_CORRELACIONADO"
    elseif hp=="SEM_QUEDA_HP_CONFIAVEL" then outcome="CLIENTE_ATINGE_SEM_DANO"
    else outcome="CLIENTE_ATINGE_RESULTADO_AMBIGUO" end
   else outcome="CLIENTE_NAO_ATINGIU_ALVO" end
  end
  shot.clientPathStateV2312Hotfix=client
  shot.clientPathAuthorityV2312Hotfix=authority
  shot.hpStateV2312Hotfix=hp
  shot.outcomeV2312Hotfix=outcome
  shot.observedDamageV2312Hotfix=dmg
  shot.hpEvidenceSourceV2312Hotfix=hps
  if authority=="NOCLIP_SHARED_BUS_V2312_HOTFIX" then S.V2312ClientAuthorityCorrected+=1 end
 end

 local oldStart2312h=startDamageProbe
 startDamageProbe=function(shot,locked,tool,shotToken)
  local result=oldStart2312h(shot,locked,tool,shotToken)
  local ok,err=pcall(augmentOrigin2312h,shot,locked,tool)
  if not ok then S.V2312PostRunHotfixErrors+=1;shot.originHandleHotfixError=tostring(err) end
  return result
 end

 local function hotfixSummary2312h()
  local out={shots=0,withNestedHandle=0,withoutNestedHandle=0,cameraVsHandleDiverged=0,handleTargetBehindCandidate=0,clientAuthorityCorrected=0,errors=S.V2312PostRunHotfixErrors or 0,handleResolutionSources={},muzzleAxisAngleByWeapon={}}
  for _,shot in ipairs(S.Shots) do
   recomputeClient2312h(shot)
   local st=shot.originStudyV2312
   if st then
    out.shots+=1
    local hr=st.handleResolutionV2312Hotfix
    if hr and hr.path then out.withNestedHandle+=1;out.handleResolutionSources[hr.source]=(out.handleResolutionSources[hr.source] or 0)+1 else out.withoutNestedHandle+=1 end
    if st.comparisons and st.comparisons.cameraRayVsHandleRayDiverged==true then out.cameraVsHandleDiverged+=1 end
    if st.comparisons and st.comparisons.handleRayTargetBehindWall==true then out.handleTargetBehindCandidate+=1 end
    local a=st.comparisons and tonumber(st.comparisons.muzzleWorldAxisAngleToReferenceDeg) or nil
    if a then
     local w=shot.weapon and shot.weapon.name or "?"
     local b=out.muzzleAxisAngleByWeapon[w] or {count=0,sum=0,min=nil,max=nil}
     b.count+=1;b.sum+=a;b.min=(b.min and math.min(b.min,a)) or a;b.max=(b.max and math.max(b.max,a)) or a
     out.muzzleAxisAngleByWeapon[w]=b
    end
   end
   if shot.clientPathAuthorityV2312Hotfix=="NOCLIP_SHARED_BUS_V2312_HOTFIX" then out.clientAuthorityCorrected+=1 end
  end
  for _,b in pairs(out.muzzleAxisAngleByWeapon) do if b.count>0 then b.mean=b.sum/b.count end;b.sum=nil end
  return out
 end

 local oldExport2312h=exportTable
 exportTable=function()
  for _,shot in ipairs(S.Shots) do
   if not (shot.noClipSync and shot.noClipSync.matched) then pcall(function() attachNoClipSyncV239(shot,false) end) end
   recomputeClient2312h(shot)
  end
  local t=oldExport2312h()
  t.openEndedResearch=t.openEndedResearch or {}
  t.openEndedResearch.postRunDiagnosticHotfixV2312={
   summary=hotfixSummary2312h(),
   nestedHandleRule="Handle direto tem prioridade; caso ausente, usa o BasePart pai/ancestral do MuzzleAttachment canônico e depois um BasePart descendente chamado Handle.",
   clientAuthorityRule="Quando noClipSync.matched=true, clientReachedCharacter do shared bus também é autoridade para tiros livres/não-barreira; campos V239 legados permanecem para auditoria.",
   observationalOnly=true
  }
  t.interpretationRules=t.interpretationRules or {}
  t.interpretationRules[#t.interpretationRules+1]="V2.3.12 hotfix: TOOL_HANDLE_ORIGIN resolve Handle aninhado/canônico; o primeiro runtime tinha Muzzle em 100% dos tiros mas Handle direto ausente."
  t.interpretationRules[#t.interpretationRules+1]="V2.3.12 hotfix: clientPathAuthorityV2312Hotfix usa o shared bus também para tiros livres quando o match é válido; outcomeV239 legado é preservado para comparação."
  return t
 end

 local oldReset2312h=resetSession
 resetSession=function()
  oldReset2312h()
  S.V2312NestedHandleResolved=0;S.V2312NestedHandleMissing=0;S.V2312ClientAuthorityCorrected=0;S.V2312PostRunHotfixErrors=0
 end

 local oldUI2312h=updateUI
 updateUI=function()
  oldUI2312h()
  Sub.Text="SHOT-LOCK + ORIGENS + HANDLE ANINHADO + TIMELINE + SYNC"
 end
 S.UIRefresh=updateUI
 if type(ENV[RUNTIME_KEY])=="table" then ENV[RUNTIME_KEY].version=C.VERSION end
end)}

