-- V2.3.16C FINAL SYNC EXPORT RESTORE
-- The initial V2.3.16 export wrapper runs inside V2.3.16B and can overwrite shot.noClipSync
-- after B's first reconciliation. This final outer wrapper reapplies the corrected B sync
-- AFTER every inherited export wrapper has finished, so the serialized shot table keeps deltaTime.

C.VERSION="V2.3.16"
S.V2316CFinalRestore=true
S.V2316CFinalMatches=0
S.V2316CFinalMisses=0
S.V2316CFinalMaxDelta=0

ENV.__PSICO_V2316C_RESULT={pcall(function()
 if type(attachNoClipSyncV239)~="function" then error("V2.3.16C dependency ausente: attachNoClipSyncV239") end
 if type(exportTable)~="function" then error("V2.3.16C dependency ausente: exportTable") end

 local function restoreFinalSync()
  local matches=0
  local misses=0
  local maxDt=0
  for _,shot in ipairs(S.Shots) do
   local sync=attachNoClipSyncV239(shot,false)
   if sync and sync.matched==true and sync.source=="BULLET_NOCLIP_SEQUENCE_SCORED_OFFSET_V2316B" then
    matches+=1
    local dt=tonumber(sync.deltaTime) or 0
    if dt>maxDt then maxDt=dt end
    shot.noClipSyncV2316C={
     matched=true,
     source=sync.source,
     runId=sync.runId,
     seq=sync.seq,
     deltaTime=sync.deltaTime,
     shotIndex=sync.shotIndex,
     noClipShotIndex=sync.noClipShotIndex,
     researchShotIndex=sync.researchShotIndex,
     indexOffset=sync.indexOffset,
     weaponName=sync.weaponName,
     clientReachedCharacter=sync.clientReachedCharacter,
     crossedCandidate=sync.crossedCandidate,
     normalWallClientReached=sync.normalWallClientReached
    }
   else
    misses+=1
    shot.noClipSyncV2316C={matched=false,source=sync and sync.source or "SEM_SYNC_FINAL"}
   end
  end
  S.V2316CFinalMatches=matches
  S.V2316CFinalMisses=misses
  S.V2316CFinalMaxDelta=maxDt
  return {matches=matches,misses=misses,maxDelta=maxDt,offset=S.V2316BOffset,runId=S.V2316BRunId}
 end

 local oldExport=exportTable
 exportTable=function()
  local data=oldExport()
  local final=restoreFinalSync()
  -- data.shots/openEndedResearch normally reference the live shot tables. Rebind explicitly
  -- so the post-wrapper correction is guaranteed to be the exported authority.
  data.shots=S.Shots
  data.version=C.VERSION
  data.openEndedResearch=data.openEndedResearch or {}
  data.openEndedResearch.noClipRuntimeSyncV2316C={
   authority="FINAL_POST_WRAPPER_SYNC_RESTORE",
   summary=final,
   rule="Reaplica V2.3.16B depois de todos os wrappers internos de export e torna S.Shots corrigido a autoridade serializada.",
   supersedes="V2.3.10/V2.3.16 initial export sync fields when they disagree"
  }
  if type(data.openEndedResearch.noClipRuntimeSyncV2316B)=="table" then
   data.openEndedResearch.noClipRuntimeSyncV2316B.finalizedBy="noClipRuntimeSyncV2316C"
  end
  return data
 end

 local oldReset=resetSession
 resetSession=function()
  oldReset()
  S.V2316CFinalMatches=0
  S.V2316CFinalMisses=0
  S.V2316CFinalMaxDelta=0
 end
end)}

if ENV.__PSICO_V2316C_RESULT[1]~=true then error("PSICOSENATICO V2.3.16C final sync restore: "..tostring(ENV.__PSICO_V2316C_RESULT[2])) end
event("V2316C_FINAL_SYNC_EXPORT_READY",{version=C.VERSION,postWrapperRestore=true,deltaTimePreserved=true,serializedShotsRebound=true})