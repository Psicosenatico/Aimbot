-- V2.3.12 NORMAL WALL TARGET-SEGMENT CORRECTION • STRUCTURAL-SAFE
-- Loaded after V2_3_12.origin_pipeline_structural_safe.patch.
-- Prevents a candidate wall BEHIND the target from being counted as wall penetration.
-- Observational only; preserves SHOT-LOCK, HP logic, NoClip mechanics and PlayerOnly strategy.

C.VERSION="V2.3.12"
S.V2312NormalWallSegmentReady=true
S.V2312NormalWallLegacyFalsePositive=0

ENV.__PSICO_V2312_NORMAL_RESULT={pcall(function()
 local BUS_KEY="__PSICO_BULLET_RESEARCH_SHARED_BUS_V1"

 local function targetDistance(shot)
  local sync=shot and shot.noClipSync
  local hit=sync and sync.diagnosticBaselineHit
  if hit and hit.humanoid==true and tonumber(hit.distance) then
   return tonumber(hit.distance),"NOCLIP_SYNC_BASELINE_HUMANOID"
  end
  local tr=shot and shot.wallTraversal
  if tr and tonumber(tr.targetDistance) then return tonumber(tr.targetDistance),"RESEARCH_WALL_TRAVERSAL_TARGET" end
  local ref=shot and shot.referenceRay
  local idx=ref and ref.firstCharacterIndex
  local item=idx and ref.multiHitChain and ref.multiHitChain[idx] or nil
  if item and tonumber(item.totalDistance or item.distance) then
   return tonumber(item.totalDistance or item.distance),"RESEARCH_REFERENCE_CHARACTER"
  end
  local ctx=shot and shot.targetProtectionContext
  if ctx and type(ctx.rootPosition)=="table" and ref and type(ref.origin)=="table" and type(ref.direction)=="table" then
   local o=Vector3.new(ref.origin[1] or 0,ref.origin[2] or 0,ref.origin[3] or 0)
   local d=Vector3.new(ref.direction[1] or 0,ref.direction[2] or 0,ref.direction[3] or 0)
   local rp=Vector3.new(ctx.rootPosition[1] or 0,ctx.rootPosition[2] or 0,ctx.rootPosition[3] or 0)
   if d.Magnitude>0 then return (rp-o):Dot(d.Unit),"TARGET_ROOT_PROJECTION" end
  end
  return nil,"TARGET_DISTANCE_UNAVAILABLE"
 end

 local function busRecordForShot(shot)
  local sync=shot and shot.noClipSync
  if not sync or not sync.matched then return nil end
  local wanted=tonumber(sync.shotIndex)
  if not wanted then return nil end
  local bus=ENV[BUS_KEY]
  if type(bus)~="table" or type(bus.records)~="table" then return nil end
  for i=#bus.records,1,-1 do
   local r=bus.records[i]
   if r and tonumber(r.shotIndex)==wanted then return r end
  end
  return nil
 end

 local function relationFromNoClip(shot)
  local r=busRecordForShot(shot)
  if not r or not r.normalWallSegmentRelation then return nil end
  if shot.noClipSync then
   shot.noClipSync.normalWallSegmentRelation=r.normalWallSegmentRelation
   shot.noClipSync.normalWallBetweenCameraAndTarget=r.normalWallBetweenCameraAndTarget==true
   shot.noClipSync.normalWallTargetDistance=r.normalWallTargetDistance
   shot.noClipSync.normalWallBundle=r.normalWallBundle
   shot.noClipSync.normalWallClientReachedLegacy=r.normalWallClientReachedLegacy==true
   shot.noClipSync.normalWallClientReached=r.normalWallClientReached==true
  end
  return {
   relation=r.normalWallSegmentRelation,
   between=r.normalWallBetweenCameraAndTarget==true,
   targetDistance=tonumber(r.normalWallTargetDistance),
   bundle=r.normalWallBundle,
   clientReached=r.normalWallClientReached==true,
   legacyClientReached=r.normalWallClientReachedLegacy==true,
   source="NOCLIP_V013_SHARED_BUS"
  }
 end

 local function barrierBundleIndex(shot)
  if type(v238FindBarrier)~="function" then return nil end
  local ok,b=pcall(function()
   local barrier=v238FindBarrier(shot)
   return barrier
  end)
  return ok and b and tonumber(b.bundleIndex) or nil
 end

 local function relationFromResearch(shot)
  local tr=shot and shot.wallTraversal
  local td,tdSource=targetDistance(shot)
  if not tr or type(tr.compositeBundles)~="table" then
   return {relation="SEM_PAREDE_COMUM_CANDIDATA",between=false,targetDistance=td,targetDistanceSource=tdSource,source="RESEARCH_GEOMETRY_FALLBACK"}
  end
  local skipIndex=barrierBundleIndex(shot)
  local before,inside,behind=nil,nil,nil
  local count=0
  for i,b in ipairs(tr.compositeBundles) do
   if i~=skipIndex then
    count+=1
    local entry=tonumber(b.entryDistance)
    local exit=tonumber(b.exitDistance)
    if entry and exit and td then
     local info={bundleIndex=i,entryDistance=entry,exitDistance=exit,compositeThickness=tonumber(b.compositeThickness),memberCount=tonumber(b.memberCount),members=b.members}
     if td>exit+0.05 then
      if not before or entry<before.entryDistance then before=info end
     elseif td<entry-0.05 then
      if not behind or entry<behind.entryDistance then behind=info end
     else
      if not inside or entry<inside.entryDistance then inside=info end
     end
    end
   end
  end
  local out={targetDistance=td,targetDistanceSource=tdSource,candidateBundleCount=count,source="RESEARCH_GEOMETRY_FALLBACK"}
  if count==0 then out.relation="SEM_PAREDE_COMUM_CANDIDATA"
  elseif not td then out.relation="PAREDE_COMUM_SEM_ALVO_VALIDADO"
  elseif before then out.relation="PAREDE_COMUM_ENTRE_CAMERA_E_ALVO";out.bundle=before;out.between=true
  elseif inside then out.relation="ALVO_DENTRO_OU_NA_PAREDE_COMUM";out.bundle=inside
  elseif behind then out.relation="PAREDE_COMUM_ATRAS_DO_ALVO";out.bundle=behind
  else out.relation="PAREDE_COMUM_SEM_RELACAO_RESOLVIDA" end
  out.between=out.between==true
  local sync=shot and shot.noClipSync
  local reached=sync and sync.clientReachedCharacter==true or false
  out.clientReached=reached and out.between
  out.legacyClientReached=sync and sync.normalWallClientReached==true or false
  return out
 end

 local function applyRelation(shot)
  if not shot then return nil end
  local rel=relationFromNoClip(shot) or relationFromResearch(shot)
  shot.normalWallSegmentV2312=rel
  shot.normalWallSegmentRelationV2312=rel.relation
  shot.normalWallBetweenCameraAndTargetV2312=rel.between==true
  shot.normalWallTargetDistanceV2312=rel.targetDistance
  shot.normalWallSegmentAuthorityV2312=rel.source
  shot.normalWallClientReachedLegacyV2312=rel.legacyClientReached==true
  shot.normalWallClientReachedV2312=rel.clientReached==true
  if shot.noClipSync and shot.noClipSync.matched then
   local old=shot.noClipSync.normalWallClientReached==true
   shot.noClipSync.normalWallClientReachedLegacyV2312=old
   shot.noClipSync.normalWallClientReached=rel.clientReached==true
   shot.noClipSync.normalWallSegmentRelation=rel.relation
   shot.noClipSync.normalWallBetweenCameraAndTarget=rel.between==true
  end
  if rel.legacyClientReached and not rel.clientReached then
   shot.normalWallLegacyFalsePositiveV2312=true
  end
  return rel
 end

 local function hpState(shot)
  local p=shot and shot.damageProbe
  local d=tonumber(p and p.observedDamage) or 0
  if p and p.reliable==true and p.status=="QUEDA_DE_HP_OBSERVADA" and d>0.001 then return "DANO_CONFIRMADO",d end
  local inter=tonumber(shot and shot.interShotHealthDelta and shot.interShotHealthDelta.observedDamage) or 0
  if inter>0.001 then return "DANO_OBSERVADO_CORRELACIONADO",inter end
  if p and p.reliable==true and p.status=="SEM_QUEDA_DE_HP_OBSERVADA" then return "SEM_QUEDA_HP_CONFIAVEL",0 end
  return "DANO_AMBIGUO",0
 end

 local function correctedSummary()
  local out={
   shotsWithAnyNormalCandidate=0,betweenTarget=0,behindTarget=0,targetInside=0,noTarget=0,noCandidate=0,
   clientReachedBetween=0,legacyFalsePositive=0,damageConfirmed=0,damageCorrelated=0,
   clientReachedNoDamage=0,ambiguous=0,totalConfirmedDamage=0,totalCorrelatedDamage=0,byAuthority={}
  }
  for _,shot in ipairs(S.Shots) do
   local rel=applyRelation(shot)
   local r=rel and rel.relation
   if r~="SEM_PAREDE_COMUM_CANDIDATA" then out.shotsWithAnyNormalCandidate+=1 end
   if r=="PAREDE_COMUM_ENTRE_CAMERA_E_ALVO" then out.betweenTarget+=1
   elseif r=="PAREDE_COMUM_ATRAS_DO_ALVO" then out.behindTarget+=1
   elseif r=="ALVO_DENTRO_OU_NA_PAREDE_COMUM" then out.targetInside+=1
   elseif r=="PAREDE_COMUM_SEM_ALVO_VALIDADO" then out.noTarget+=1
   elseif r=="SEM_PAREDE_COMUM_CANDIDATA" then out.noCandidate+=1 end
   local auth=tostring(rel and rel.source or "UNKNOWN")
   out.byAuthority[auth]=(out.byAuthority[auth] or 0)+1
   if rel and rel.clientReached and rel.between then
    out.clientReachedBetween+=1
    local hp,damage=hpState(shot)
    shot.normalWallHpStateV2312=hp
    shot.normalWallObservedDamageV2312=damage
    if hp=="DANO_CONFIRMADO" then out.damageConfirmed+=1;out.totalConfirmedDamage+=damage
    elseif hp=="DANO_OBSERVADO_CORRELACIONADO" then out.damageCorrelated+=1;out.totalCorrelatedDamage+=damage
    elseif hp=="SEM_QUEDA_HP_CONFIAVEL" then out.clientReachedNoDamage+=1
    else out.ambiguous+=1 end
   end
   if shot.normalWallLegacyFalsePositiveV2312 then out.legacyFalsePositive+=1 end
  end
  S.V2312NormalWallLegacyFalsePositive=out.legacyFalsePositive
  return out
 end

 local oldExport=exportTable
 exportTable=function()
  -- Correct per-shot sync flags BEFORE older summary wrappers execute.
  for _,shot in ipairs(S.Shots) do applyRelation(shot) end
  local t=oldExport()
  local summary=correctedSummary()
  t.version=C.VERSION
  t.openEndedResearch=t.openEndedResearch or {}
  t.openEndedResearch.normalWallTargetSegmentV2312={
   rule="Parede comum só é considerada ENTRE câmera/origem e alvo quando wallExitDistance < targetDistance. Candidata atrás do personagem não conta como penetração.",
   summary=summary,
   authoritativeWhenAvailable="NOCLIP_V013_SHARED_BUS",
   fallback="RESEARCH_GEOMETRY_FALLBACK",
   legacyFalsePositiveDefinition="normalWallClientReached antigo era true apenas por existir candidata em qualquer ponto do raio, mesmo depois do alvo."
  }
  local tb=t.openEndedResearch.teamProtectionBarrier
  if type(tb)=="table" then
   tb.normalMapWallComparisonLegacy=tb.normalMapWallComparison
   tb.normalMapWallComparisonCorrectedV2312=summary
  end
  t.interpretationRules=t.interpretationRules or {}
  t.interpretationRules[#t.interpretationRules+1]="V2.3.12: parede comum atrás do alvo é explicitamente PAREDE_COMUM_ATRAS_DO_ALVO e nunca conta como clientReached/penetração."
  t.interpretationRules[#t.interpretationRules+1]="Para cada origem Camera/Head/HRP/Handle/Muzzle, a comparação de parede deve respeitar a mesma regra de segmento: entrada/saída da parede antes da distância projetada do alvo."
  return t
 end

 local oldUpdate=updateUI
 updateUI=function()
  oldUpdate()
  Ver.Text=C.VERSION
  local last=S.Shots[#S.Shots]
  if last then
   local rel=applyRelation(last)
   if rel and rel.relation=="PAREDE_COMUM_ENTRE_CAMERA_E_ALVO" then
    MHelp.Text="PAREDE COMUM ENTRE ORIGEM E ALVO • "..tostring(rel.source)
   elseif rel and rel.relation=="PAREDE_COMUM_ATRAS_DO_ALVO" then
    MHelp.Text="PAREDE ATRÁS DO ALVO • NÃO CONTA COMO PENETRAÇÃO"
   end
  end
 end
 S.UIRefresh=updateUI
 local rt=ENV[RUNTIME_KEY]
 if type(rt)=="table" then rt.version=C.VERSION end
end)}
if ENV.__PSICO_V2312_NORMAL_RESULT[1]~=true then error("PSICOSENATICO V2.3.12 normal-wall structural init: "..tostring(ENV.__PSICO_V2312_NORMAL_RESULT[2])) end
event("V2312_NORMAL_WALL_SEGMENT_READY",{structuralSafe=true,wallBeforeTargetRule=true,wallBehindTargetExcluded=true,preservesNoClipMechanism=true,version=C.VERSION})
pcall(updateUI)
