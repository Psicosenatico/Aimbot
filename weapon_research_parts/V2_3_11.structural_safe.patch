 end

 local oldUpdateUI=updateUI
 updateUI=function()
  oldUpdateUI()
  Ver.Text=C.VERSION
  Sub.Text="SHOT-LOCK + BARREIRA EFETIVA + DIREÇÃO + TEAM"
