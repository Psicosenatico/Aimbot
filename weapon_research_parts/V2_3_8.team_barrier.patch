  local name="Psicosenatico_WeaponResearch_V2_3_8_"..tostring(game.PlaceId).."_"..tostring(os.time())..".json"
  local saved=false
  if typeof(writefile)=="function" then saved=pcall(function() writefile(name,data) end) end
  if saved then S.Exported=true;Status.Text="✓ ARQUIVO EXPORTADO: "..name;Status.TextColor3=COL.green
  elseif typeof(setclipboard)=="function" and pcall(function() setclipboard(data) end) then S.Exported=true;Status.Text="✓ JSON COPIADO.";Status.TextColor3=COL.green
  else Status.Text="Não foi possível salvar ou copiar o JSON.";Status.TextColor3=COL.red end
  S.ExportBusy=false;updateUI()
 end)
end)

