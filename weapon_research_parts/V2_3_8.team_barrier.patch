local NewExport238=new("TextButton",{Parent=Main,Size=UDim2.new(0.5,-17,0,34),Position=UDim2.new(0.5,3,0,81),Text="EXPORTAR",BackgroundColor3=COL.blue,TextColor3=COL.text,Font=Enum.Font.GothamBold,TextSize=10,BorderSizePixel=0})
round(NewExport238,8)
pcall(function() oldExport238:Destroy() end)
Export=NewExport238
Export.Activated:Connect(function()
 if not S.Started then Status.Text="Inicie a coleta antes de exportar.";Status.TextColor3=COL.yellow;return end
 if S.ExportBusy then Status.Text="Exportação já está em andamento.";Status.TextColor3=COL.yellow;return end
 if S.Recording then pauseSession("EXPORT") end
 S.ExportBusy=true
 Status.Text="Preparando JSON V2.3.8 • cruzando barreira, trajetória e HP."
