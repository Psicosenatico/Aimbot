 local ReplicatedStorage=game:GetService("ReplicatedStorage")
 local MAX_SOURCE_CHARS=180000

 local function envFunction(name)
  local v=nil
  pcall(function()
   if type(ENV)=="table" then v=rawget(ENV,name) end
  end)
  if type(v)=="function" then return v,"ENV" end
  local g=nil
  pcall(function() g=_G[name] end)
  if type(g)=="function" then return g,"_G" end
  return nil,nil
 end

 local function debugConstantsFunction()
  local f=nil
  pcall(function()
   if debug and type(debug.getconstants)=="function" then f=debug.getconstants end
  end)
  if type(f)=="function" then return f,"debug.getconstants" end
  local alt,src=envFunction("getconstants")
  return alt,src
 end

 local function rollingChecksum(s)
  if type(s)~="string" then return nil end
  local h=0
  local n=math.min(#s,120000)
  for i=1,n do h=(h*131+string.byte(s,i))%4294967291 end
  return string.format("%08X",h),n
 end

 local function keywordCounts(source)
  local out={}
  if type(source)~="string" then return out end
  local keys={"RayExclude","RaycastParams","CollisionGroup","FilterDescendantsInstances","RespectCanCollide","canPierce","Workspace:Raycast","ProjectileHit","BulletsCannotPierce","CollectionService"}
  for _,k in ipairs(keys) do
   local n=0
   local pos=1
   while true do
    local a,b=string.find(source,k,pos,true)
    if not a then break end
    n+=1
    pos=b+1
   end
   out[k]=n
  end
  return out
 end

 local function locateTargets()
  local root=ReplicatedStorage:FindFirstChild("BlasterSystem")
  local list={}
  if not root then return list,"BLASTERSYSTEM_AUSENTE" end
  for _,d in ipairs(root:GetDescendants()) do
   if d:IsA("ModuleScript") and (d.Name=="castRays" or d.Name=="canPierce") then
    list[#list+1]=d
   end
  end
  table.sort(list,function(a,b) return a:GetFullName()<b:GetFullName() end)
  return list,nil
 end

 local function inspectOne(module,decompileFn,bytecodeFn,closureFn,constantsFn)
  local result={name=module.Name,path=module:GetFullName(),class=module.ClassName,sourceMethod="NONE",source="",sourceLength=0,decompileAttempted=false,decompileSucceeded=false}

  local okSource,propSource=pcall(function() return module.Source end)
  result.sourcePropertyReadable=okSource
  result.sourcePropertyLength=okSource and type(propSource)=="string" and #propSource or 0

  if type(decompileFn)=="function" then
   result.decompileAttempted=true
   local ok,res=pcall(decompileFn,module)
   if ok and type(res)=="string" and #res>0 then
    result.decompileSucceeded=true
    result.sourceMethod="decompile"
    result.sourceLength=#res
    result.sourceTruncated=#res>MAX_SOURCE_CHARS
    result.source=string.sub(res,1,MAX_SOURCE_CHARS)
   else
    result.decompileError=tostring(res)
   end
  end

  if result.sourceLength==0 and okSource and type(propSource)=="string" and #propSource>0 then
   result.sourceMethod="SourceProperty"
   result.sourceLength=#propSource
   result.sourceTruncated=#propSource>MAX_SOURCE_CHARS
   result.source=string.sub(propSource,1,MAX_SOURCE_CHARS)
  end

  if type(bytecodeFn)=="function" then
   local ok,bc=pcall(bytecodeFn,module)
   result.bytecodeAttempted=true
   result.bytecodeSucceeded=ok and type(bc)=="string" and #bc>0
   if result.bytecodeSucceeded then
    result.bytecodeLength=#bc
    result.bytecodeChecksum,result.bytecodeChecksumBytes=rollingChecksum(bc)
   else
    result.bytecodeError=tostring(bc)
   end
  end

  if result.sourceLength==0 and type(closureFn)=="function" and type(constantsFn)=="function" then
   local okClosure,closure=pcall(closureFn,module)
   result.scriptClosureAttempted=true
   if okClosure and type(closure)=="function" then
    local okConst,constants=pcall(constantsFn,closure)
    result.constantsAttempted=true
    if okConst and type(constants)=="table" then
     result.constants={}
     for i=1,math.min(#constants,240) do
      local v=constants[i]
      local tv=typeof(v)
      if tv=="string" or tv=="number" or tv=="boolean" then result.constants[#result.constants+1]=v end
     end
     result.constantsCaptured=#result.constants
    else
     result.constantsError=tostring(constants)
    end
   else
    result.scriptClosureError=tostring(closure)
   end
  end

  result.keywordCounts=keywordCounts(result.source)
  return result
 end

 local function collectSourceV2317(reason)
  if S.V2317SourceRecoveryBusy then return S.V2317SourceRecovery end
  S.V2317SourceRecoveryBusy=true
  S.V2317SourceRecoveryLastReason=reason
  local state={attempts=0,successes=0,failures=0,reason=reason,targets={},capabilities={},observationalOnly=true,noRequire=true,noRemoteCalls=true}

  local decompileFn,decompileSource=envFunction("decompile")
  local bytecodeFn,bytecodeSource=envFunction("getscriptbytecode")
  local closureFn,closureSource=envFunction("getscriptclosure")
  local constantsFn,constantsSource=debugConstantsFunction()
  state.capabilities={
   decompile=type(decompileFn)=="function",decompileSource=decompileSource,
   getscriptbytecode=type(bytecodeFn)=="function",getscriptbytecodeSource=bytecodeSource,
   getscriptclosure=type(closureFn)=="function",getscriptclosureSource=closureSource,
   getconstants=type(constantsFn)=="function",getconstantsSource=constantsSource
  }

  local targets,why=locateTargets()
  state.targetCount=#targets
  state.locateError=why
  for _,m in ipairs(targets) do
   state.attempts+=1
   local ok,res=pcall(inspectOne,m,decompileFn,bytecodeFn,closureFn,constantsFn)
   if ok and type(res)=="table" then
    state.targets[#state.targets+1]=res
    if (res.sourceLength or 0)>0 then state.successes+=1 else state.failures+=1 end
   else
    state.failures+=1
    state.targets[#state.targets+1]={name=m.Name,path=m:GetFullName(),error=tostring(res),sourceLength=0}
   end
  end
  state.completedAtUnix=os.time()
  S.V2317SourceRecovery=state
  S.V2317SourceRecoveryBusy=false
  pcall(function() event("V2317_SOURCE_RECOVERY",{reason=reason,attempts=state.attempts,successes=state.successes,failures=state.failures,targetCount=state.targetCount,capabilities=state.capabilities}) end)
  pcall(updateUI)
  return state
 end

