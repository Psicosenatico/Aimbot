confirmedShotRecords=#S.Shots,
roundsConsumed=S.RoundCount,
uniqueLocations=#S.LocationOrder,
errors=S.Errors,
byCategory=categorySummary(),
damage=damageSummary()
},
architecture=S.Architecture,
sourceInspection=S.SourceInspection,
boundarySurvey=S.BoundarySurvey,
explicitProjectileBlockers={
attribute="BulletsCannotPierce",
value=true,
totalDetected=S.ExplicitBlockerScanTotal,
stored=S.ExplicitBlockers
},
locations=buildLocationSummary(),
tools=serializeTools(),
shots=S.Shots,
events=S.Events,
interpretationRules={
"Não existe limite programado de tiros; a sessão continua até ser pausada, fechada ou reiniciada.",
"Cada redução confirmada de _ammo gera um registro e é classificada automaticamente pela trajetória observada.",
"TIRO_LIVRE = nenhum impacto no alcance do raycast de referência.",
"ESTRUTURA_BASE = geometria sob Workspace.Tycoons; protegida e marcada para NÃO atravessar.",
"ESTRUTURA_MAPA_PAREDE = Wall nomeada ou painel vertical provável dentro de Workspace.Map; apenas candidata e requer teste.",
"ESTRUTURA_MAPA_OBSTACULO = item sob Workspace.Map.CombatObstacles; separado para teste, sem liberação automática.",
"ESTRUTURA_MAPA_TERRENO_PROTEGIDO = Ground/Mountain/TerrainPart; nunca candidato automático ao Wall Penetration.",
"ESTRUTURA_MAPA_LOGICA_PROTEGIDA = team colors/spawn/lógica do mapa; nunca candidato automático.",
"ESTRUTURA_MAPA_GENERICA_REVISAR = geometria de Workspace.Map sem marcador suficiente; não atravessar por padrão.",
"OUTRA_ESTRUTURA = geometria fora de Workspace.Tycoons/Map; não atravessar por padrão até revisão.",
"LASERGATE_PROTEGIDO = LaserGate/BulletsCannotPierce=true; sempre protegido e separado.",
"ALVO_ATRAS_ESTRUTURA_BASE = personagem atrás de geometria de Workspace.Tycoons; manter proteção da base.",
"ALVO_ATRAS_MAPA_PAREDE = personagem atrás somente de parede(s) candidata(s) do mapa.",
"ALVO_ATRAS_MAPA_OBSTACULO = personagem atrás de obstáculo(s) de combate do mapa.",
"ALVO_ATRAS_MAPA_TERRENO_PROTEGIDO = personagem atrás de terreno protegido do mapa.",
"ALVO_ATRAS_MAPA_LOGICA_PROTEGIDA = personagem atrás de estrutura lógica protegida do mapa.",
"ALVO_ATRAS_MAPA_GENERICA_REVISAR = personagem atrás de geometria genérica/mista de Workspace.Map; revisar.",
"ALVO_ATRAS_OUTRA_ESTRUTURA = personagem atrás de geometria fora de Map/Tycoons; revisar.",
"ALVO_ATRAS_LASERGATE_PROTEGIDO = personagem atrás de LaserGate; manter proteção.",
"ALVO_LIVRE = personagem é o primeiro impacto.",
"locations agrupa tiros por categoria, objeto principal e célula espacial de 20 studs; o caminho e a posição completos continuam no tiro individual.",
"multiHitChain percorre cumulativamente até 12 peças/impactos alinhados e não simula canPierce.",
"damageProbe observa Humanoid.Health usando Tool.Activated e, em armas Auto, uma baseline temporal pós-tiro para o próximo disparo da rajada.",
"QUEDA_DE_HP_OBSERVADA indica correlação temporal com o disparo, não prova causal exclusiva.",
"SEM_QUEDA_DE_HP_OBSERVADA significa somente que nenhuma redução foi observada na janela configurada.",
"POSSIVEL_LIMITE_MAPA é heurístico e não substitui uma regra exclusivamente do servidor.",
"Nenhum RemoteEvent é disparado e nenhum ModuleScript é executado via require()."
}
}
end
local function encode()
local ok,v=pcall(function()
return HttpService:JSONEncode(exportTable())
end)
return ok and v or nil,ok and nil or v
end
local COL={
