-- V2.3.17B SOURCE-ONLY EXPORT • STRUCTURAL SAFE
-- Allows exporting sourceRecoveryV2317 without starting/shooting.
-- Important: does NOT call collectSourceV2317 directly because that function is intentionally
-- local to V2.3.17's closure. encode()->exportTable() invokes the recovery inside its valid scope.

C.VERSION="V2.3.17"
S.V2317BSourceOnlyExport=true

ENV.__PSICO_V2317B_SAFE_RESULT={pcall(function()
 if type(new)~="function" or type(round)~="function" or type(encode)~="function" then error("V2.3.17B SAFE dependencias UI/export incompletas") end
 if Export==nil or Main==nil or Gui==nil then error("V2.3.17B SAFE UI ausente") end

 local previous=Export
 local button=new("TextButton",{Parent=Main,Size=UDim2.new(0.5,-17,0,34),Position=UDim2.new(0.5,3,0,81),Text="EXPORTAR",BackgroundColor3=COL.blue,TextColor3=COL.text,Font=Enum.Font.GothamBold,TextSize=10,BorderSizePixel=0})
 round(button,8)
 button.Activated:Connect(function()
  if S.ExportBusy then Status.Text="Exportacao ja esta em andamento.";Status.TextColor3=COL.yellow;return end
  if S.Recording and type(pauseSession)=="function" then pauseSession("EXPORT") end
  S.ExportBusy=true
  Status.Text="Preparando JSON V2.3.17 • source recovery sem tiros..."
  Status.TextColor3=COL.yellow
  pcall(updateUI)
  local sessionId=S.SessionId
  task.spawn(function()
   while Gui.Parent and S.SessionId==sessionId and (S.PendingDamageProbes or 0)>0 do task.wait(0.05) end
   if not Gui.Parent or S.SessionId~=sessionId then return end
   -- V2.3.17 exportTable performs source recovery here, inside the closure where its local function exists.
   local data,encErr=encode()
   if not data then S.ExportBusy=false;Status.Text="Falha JSON: "..tostring(encErr);Status.TextColor3=COL.red;pcall(updateUI);return end
   local filename="Psicosenatico_WeaponResearch_V2_3_17_"..tostring(game.PlaceId).."_"..tostring(os.time())..".json"
   local saved=false
   if typeof(writefile)=="function" then saved=pcall(function() writefile(filename,data) end) end
   if saved then S.Exported=true;Status.Text="✓ SOURCE RECOVERY EXPORTADO: "..filename;Status.TextColor3=COL.green
   elseif typeof(setclipboard)=="function" and pcall(function() setclipboard(data) end) then S.Exported=true;Status.Text="✓ SOURCE RECOVERY COPIADO.";Status.TextColor3=COL.green
   else Status.Text="Nao foi possivel salvar ou copiar o JSON.";Status.TextColor3=COL.red end
   S.ExportBusy=false
   pcall(updateUI)
  end)
 end)
 pcall(function() previous:Destroy() end)
 Export=button
end)}

if ENV.__PSICO_V2317B_SAFE_RESULT[1]~=true then error("PSICOSENATICO V2.3.17B SAFE source-only export: "..tostring(ENV.__PSICO_V2317B_SAFE_RESULT[2])) end
event("V2317B_SOURCE_ONLY_EXPORT_SAFE_READY",{version=C.VERSION,requiresStarted=false,requiresShots=false,usesExportClosureRecovery=true,noRequire=true,noRemoteCalls=true,writesCanCollide=false,writesCanQuery=false})