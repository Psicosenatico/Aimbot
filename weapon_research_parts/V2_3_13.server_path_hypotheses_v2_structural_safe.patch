 startDamageProbe=function(shot,locked,tool,shotToken)
  local result=oldStart(shot,locked,tool,shotToken)
  local ok,err=pcall(attachStudy,shot,locked,tool)
  if not ok then S.V2313Errors+=1;if shot then shot.serverPathHypothesesV2313Error=tostring(err) end end
  return result
 end

 local function summarize()
  local names={"MUZZLE_REFERENCE_DIRECTION","MUZZLE_WORLD_AXIS","MUZZLE_TO_AIM_POINT","HANDLE_REFERENCE_DIRECTION","HANDLE_LOOK_VECTOR","HANDLE_TO_AIM_POINT"}
  local out={shots=0,errors=S.V2313Errors or 0,localReachedHpDenied=0,localReachedHpDamageReliable=0,localReachedHpDamageCorrelated=0,
   localReachedHpAmbiguous=0,freeControlDamageReliable=0,barrierLocalReachedHpDenied=0,normalWallLocalReachedHpDenied=0,variants={},evidenceMatrix={},byWeapon={}}
  for _,name in ipairs(names) do out.variants[name]={available=0,firstHitTarget=0,chainFindsTarget=0,candidateEntryBeforeTarget=0,blockedBeforeTarget=0,noHit=0,deniedButFirstHitTarget=0,deniedAndBlockedBeforeTarget=0} end
  for _,shot in ipairs(S.Shots) do
   local study=shot.serverPathHypothesesV2313
   if type(study)=="table" then
    out.shots+=1
    local reached=clientEvidence(shot)
    local hp,damage=hpEvidence(shot)
    study.hpEvidenceAtExport=hp;study.observedDamageAtExport=damage;study.clientReachedAtExport=reached==true
    local evidence="LOCAL_NOT_REACHED_OR_UNKNOWN"
    if reached then
     if hp=="HP_NO_DROP_RELIABLE" then evidence="LOCAL_REACHED_HP_DENIED";out.localReachedHpDenied+=1
     elseif hp=="HP_DAMAGE_RELIABLE" then evidence="LOCAL_REACHED_HP_DAMAGE_RELIABLE";out.localReachedHpDamageReliable+=1
     elseif hp=="HP_DAMAGE_CORRELATED" then evidence="LOCAL_REACHED_HP_DAMAGE_CORRELATED";out.localReachedHpDamageCorrelated+=1
     else evidence="LOCAL_REACHED_HP_AMBIGUOUS";out.localReachedHpAmbiguous+=1 end
    end
    study.evidenceClassAtExport=evidence
    out.evidenceMatrix[evidence]=(out.evidenceMatrix[evidence] or 0)+1
    local weapon=shot.weapon and shot.weapon.name or "?"
    local wb=out.byWeapon[weapon] or {shots=0,denied=0,damageReliable=0};wb.shots+=1
    if evidence=="LOCAL_REACHED_HP_DENIED" then wb.denied+=1 end
    if evidence=="LOCAL_REACHED_HP_DAMAGE_RELIABLE" then wb.damageReliable+=1 end
    out.byWeapon[weapon]=wb
    if shot.autoCategory=="ALVO_LIVRE" and evidence=="LOCAL_REACHED_HP_DAMAGE_RELIABLE" then out.freeControlDamageReliable+=1 end
    if shot.barrierBetweenCameraAndTargetV2311==true and evidence=="LOCAL_REACHED_HP_DENIED" then out.barrierLocalReachedHpDenied+=1 end
    if shot.normalWallBetweenCameraAndTargetV2312==true and evidence=="LOCAL_REACHED_HP_DENIED" then out.normalWallLocalReachedHpDenied+=1 end
    for _,name in ipairs(names) do
     local v=study.variants and study.variants[name];local b=out.variants[name]
     if v then
      b.available+=1
      if not v.firstHit then b.noHit+=1 end
      if v.firstHitIsTarget==true then b.firstHitTarget+=1 end
      if v.chainFindsTarget==true then b.chainFindsTarget+=1 end
      if v.candidateEntryBeforeTarget==true or v.targetBehindCandidate==true then b.candidateEntryBeforeTarget+=1 end
      if v.blockedBeforeTarget==true then b.blockedBeforeTarget+=1 end
      if evidence=="LOCAL_REACHED_HP_DENIED" and v.firstHitIsTarget==true then b.deniedButFirstHitTarget+=1 end
      if evidence=="LOCAL_REACHED_HP_DENIED" and v.blockedBeforeTarget==true then b.deniedAndBlockedBeforeTarget+=1 end
     end
    end
   end
  end
  return out
 end

