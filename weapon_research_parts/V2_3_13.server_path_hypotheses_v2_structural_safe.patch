   summary=summarize(),variants={"MUZZLE_REFERENCE_DIRECTION","MUZZLE_WORLD_AXIS","MUZZLE_TO_AIM_POINT","HANDLE_REFERENCE_DIRECTION","HANDLE_LOOK_VECTOR","HANDLE_TO_AIM_POINT"},
